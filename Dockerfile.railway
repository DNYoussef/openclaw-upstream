FROM node:22-bookworm

# Install Bun (required for build scripts)
RUN curl -fsSL https://bun.sh/install | bash -s "bun-v1.1.0"
ENV PATH="/root/.bun/bin:${PATH}"

RUN corepack enable

# Install gosu for privilege dropping on Railway
RUN apt-get update && apt-get install -y --no-install-recommends gosu sqlite3 && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG OPENCLAW_DOCKER_APT_PACKAGES=""
RUN if [ -n "$OPENCLAW_DOCKER_APT_PACKAGES" ]; then \
      apt-get update && \
      DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $OPENCLAW_DOCKER_APT_PACKAGES && \
      apt-get clean && \
      rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*; \
    fi

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY ui/package.json ./ui/package.json
COPY patches ./patches
COPY scripts ./scripts

RUN pnpm install --frozen-lockfile

COPY . .
RUN OPENCLAW_A2UI_SKIP_MISSING=1 pnpm build
ENV OPENCLAW_PREFER_PNPM=1
RUN pnpm ui:build

ENV NODE_ENV=production

# Bake LiteLLM-routed config OUTSIDE the /data volume mount
# Uses ${VAR} env var substitution (resolved by OpenClaw config loader)
RUN mkdir -p /app/.openclaw /app/.openclaw/extensions
COPY docker/railway-config.json /app/.openclaw/openclaw.json
# Keep a baked copy so entrypoint.sh can restore it after runtime corruption
COPY docker/railway-config.json /app/.openclaw/openclaw.json.baked
COPY guardspine/extensions/guardspine /app/.openclaw/extensions/guardspine
COPY guardspine/extensions/n8n-pipeline /app/.openclaw/extensions/n8n-pipeline

# Schema only -- data lives on Railway volume, never in git or Docker image
COPY guardspine/data/migration.sql /app/.openclaw/data/migration.sql

# Workspace templates -- .railwayignore excludes docs/ so we bake them inline.
# OpenClaw requires these at /app/docs/reference/templates/ for agent sessions.
RUN mkdir -p /app/docs/reference/templates && \
    printf '%s\n' \
      '# Agent Workspace' \
      '' \
      'You are a Paperclip-managed agent. Execute tasks from your assigned issues.' \
      '' \
      '## Rules' \
      '- Follow your system prompt exactly' \
      '- Post results as issue comments' \
      '- Update issue status when done' \
      '- All tool calls governed by GuardSpine (L0-L4)' \
      > /app/docs/reference/templates/AGENTS.md && \
    printf '%s\n' \
      '# Soul' \
      '' \
      'You are an AI agent in the GuardSpine autonomous business system.' \
      'You operate under governance. Evidence over opinions. Every time.' \
      > /app/docs/reference/templates/SOUL.md && \
    printf '%s\n' \
      '# Tools' \
      '' \
      'Use only the tools provided by the gateway.' \
      'Do not guess endpoints. Follow the wake text procedure.' \
      > /app/docs/reference/templates/TOOLS.md && \
    printf '%s\n' \
      '# Identity' \
      '' \
      'You are managed by Paperclip and governed by GuardSpine.' \
      > /app/docs/reference/templates/IDENTITY.md && \
    printf '%s\n' \
      '# User' \
      '' \
      'The human operator is David Youssef, founder of GuardSpine.' \
      > /app/docs/reference/templates/USER.md && \
    printf '%s\n' \
      '# Heartbeat' \
      '' \
      'On heartbeat: check assigned issues, execute pending work, report status.' \
      > /app/docs/reference/templates/HEARTBEAT.md && \
    printf '%s\n' \
      '# Bootstrap' \
      '' \
      'Initialize workspace. Load context. Begin task execution.' \
      > /app/docs/reference/templates/BOOTSTRAP.md && \
    printf '%s\n' \
      '# Boot' \
      '' \
      'Agent session starting. Load workspace files and begin.' \
      > /app/docs/reference/templates/BOOT.md

# Non-root user for runtime security
RUN groupadd -r openclaw && useradd -r -g openclaw -d /app -s /bin/bash openclaw && \
    chown -R openclaw:openclaw /app/.openclaw/data

# Bake auth-profiles outside volume mount so entrypoint can restore it
COPY guardspine/auth/auth-profiles.json /app/auth-profiles.json.baked

COPY guardspine/seed-auth.cjs /app/seed-auth.cjs
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD curl -f http://localhost:18789/health || exit 1

# Cache bust: 2026-03-19T23 -- force CMD layer rebuild
ENTRYPOINT ["entrypoint.sh"]
CMD ["node", "--require", "/app/seed-auth.cjs", "dist/index.js", "gateway", "--allow-unconfigured", "--bind", "lan", "--port", "18789"]
