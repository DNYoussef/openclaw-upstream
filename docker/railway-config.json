{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "controlUi": {
      "allowedOrigins": ["https://ops-portal-production-bb8b.up.railway.app"],
      "dangerouslyDisableDeviceAuth": false
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "litellm/openrouter/google/gemini-3-flash-preview",
        "fallbacks": [
          "litellm/openrouter/deepseek/deepseek-v3.2",
          "litellm/openrouter/openai/gpt-4o-mini"
        ]
      },
      "models": {
        "litellm/openrouter/google/gemini-3-flash-preview": { "alias": "Gemini 3 Flash" },
        "litellm/openrouter/deepseek/deepseek-v3.2": { "alias": "DeepSeek V3.2" },
        "litellm/openrouter/anthropic/claude-sonnet-4.6": { "alias": "Claude Sonnet 4.6" },
        "litellm/openrouter/anthropic/claude-opus-4.6": { "alias": "Claude Opus 4.6" },
        "litellm/openrouter/qwen/qwen3-coder": { "alias": "Qwen3 Coder" }
      }
    }
  },
  "models": {
    "providers": {
      "litellm": {
        "baseUrl": "${LITELLM_BASE_URL}/v1",
        "apiKey": "${LITELLM_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "openrouter/google/gemini-3-flash-preview",
            "name": "Gemini 3 Flash",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": { "input": 0.5, "output": 3, "cacheRead": 0.13, "cacheWrite": 0.5 },
            "contextWindow": 1000000,
            "maxTokens": 65536
          },
          {
            "id": "openrouter/deepseek/deepseek-v3.2",
            "name": "DeepSeek V3.2",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0.25, "output": 0.4, "cacheRead": 0.07, "cacheWrite": 0.25 },
            "contextWindow": 164000,
            "maxTokens": 8192
          },
          {
            "id": "openrouter/anthropic/claude-sonnet-4.6",
            "name": "Claude Sonnet 4.6",
            "reasoning": false,
            "input": ["text", "image"],
            "cost": { "input": 3, "output": 15, "cacheRead": 0.3, "cacheWrite": 3.75 },
            "contextWindow": 200000,
            "maxTokens": 8192
          },
          {
            "id": "openrouter/anthropic/claude-opus-4.6",
            "name": "Claude Opus 4.6",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": { "input": 5, "output": 25, "cacheRead": 0.5, "cacheWrite": 6.25 },
            "contextWindow": 1000000,
            "maxTokens": 32000
          },
          {
            "id": "openrouter/qwen/qwen3-coder",
            "name": "Qwen3 Coder",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0.22, "output": 1.0, "cacheRead": 0.05, "cacheWrite": 0.22 },
            "contextWindow": 262000,
            "maxTokens": 8192
          }
        ]
      }
    }
  }
}
