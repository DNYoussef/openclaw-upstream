{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "trustedProxies": ["100.64.0.0/10", "10.0.0.0/8"],
    "controlUi": {
      "dangerouslyDisableDeviceAuth": true,
      "allowedOrigins": ["*"]
    }
  },
  "channels": {
    "slack": {
      "allowFrom": ["*"]
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-opus-4-6",
        "fallbacks": [
          "anthropic/claude-sonnet-4-6",
          "openai-codex/gpt-5.4",
          "anthropic/claude-haiku-4-5"
        ]
      },
      "models": {
        "anthropic/claude-opus-4-6": { "alias": "Claude Opus (Sub)" },
        "anthropic/claude-sonnet-4-6": { "alias": "Claude Sonnet (Sub)" },
        "anthropic/claude-haiku-4-5": { "alias": "Claude Haiku (Sub)" },
        "openai-codex/gpt-5.4": { "alias": "GPT-5.4 (Codex Sub)" },
        "openai-codex/gpt-5.4-mini": { "alias": "GPT-5.4 Mini (Codex Sub)" },
        "litellm/gemini-flash": { "alias": "Gemini 2.5 Flash" },
        "litellm/gemini-pro": { "alias": "Gemini 2.5 Pro" }
      }
    }
  },
  "models": {
    "providers": {
      "litellm": {
        "baseUrl": "${LITELLM_BASE_URL}/v1",
        "apiKey": "${LITELLM_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "gemini-flash",
            "name": "Gemini 2.5 Flash",
            "reasoning": false,
            "input": ["text", "image"],
            "cost": { "input": 0.15, "output": 0.6, "cacheRead": 0.04, "cacheWrite": 0.15 },
            "contextWindow": 1000000,
            "maxTokens": 65536
          },
          {
            "id": "gemini-pro",
            "name": "Gemini 2.5 Pro",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": { "input": 1.25, "output": 10, "cacheRead": 0.31, "cacheWrite": 1.25 },
            "contextWindow": 1000000,
            "maxTokens": 65536
          }
        ]
      }
    }
  },
  "plugins": {
    "slots": {
      "contextEngine": "lossless-claw"
    },
    "entries": {
      "lossless-claw": {
        "enabled": true,
        "config": {
          "freshTailCount": 32,
          "contextThreshold": 0.75,
          "incrementalMaxDepth": -1,
          "summaryProvider": "litellm",
          "summaryModel": "gemini-flash",
          "ignoreSessionPatterns": ["agent:*:cron:**"]
        }
      }
    }
  }
}
