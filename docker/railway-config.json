{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    },
    "controlUi": {
      "allowedOrigins": ["https://openclaw-production-4349.up.railway.app"]
    }
  },
  "channels": {
    "slack": {
      "botToken": "${SLACK_BOT_TOKEN}",
      "appToken": "${SLACK_APP_TOKEN}"
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "litellm/openrouter/anthropic/claude-sonnet-4.5",
        "fallbacks": [
          "litellm/openrouter/deepseek/deepseek-v3.2",
          "litellm/openrouter/google/gemini-2.5-flash"
        ]
      },
      "models": {
        "litellm/openrouter/anthropic/claude-sonnet-4.5": { "alias": "Claude Sonnet 4.5" },
        "litellm/openrouter/anthropic/claude-opus-4.6": { "alias": "Claude Opus 4.6" },
        "litellm/openrouter/deepseek/deepseek-v3.2": { "alias": "DeepSeek V3.2" },
        "litellm/openrouter/google/gemini-2.5-flash": { "alias": "Gemini 2.5 Flash" },
        "litellm/openrouter/qwen/qwen3-coder": { "alias": "Qwen3 Coder" }
      }
    }
  },
  "models": {
    "providers": {
      "litellm": {
        "baseUrl": "${LITELLM_BASE_URL}/v1",
        "apiKey": "${LITELLM_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "openrouter/anthropic/claude-sonnet-4.5",
            "name": "Claude Sonnet 4.5",
            "reasoning": false,
            "input": ["text", "image"],
            "cost": { "input": 3, "output": 15, "cacheRead": 0.3, "cacheWrite": 3.75 },
            "contextWindow": 200000,
            "maxTokens": 8192
          },
          {
            "id": "openrouter/anthropic/claude-opus-4.6",
            "name": "Claude Opus 4.6",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": { "input": 5, "output": 25, "cacheRead": 0.5, "cacheWrite": 6.25 },
            "contextWindow": 200000,
            "maxTokens": 32000
          },
          {
            "id": "openrouter/deepseek/deepseek-v3.2",
            "name": "DeepSeek V3.2",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0.25, "output": 0.4, "cacheRead": 0.07, "cacheWrite": 0.25 },
            "contextWindow": 164000,
            "maxTokens": 8192
          },
          {
            "id": "openrouter/google/gemini-2.5-flash",
            "name": "Gemini 2.5 Flash",
            "reasoning": true,
            "input": ["text", "image"],
            "cost": { "input": 0.3, "output": 2.5, "cacheRead": 0.08, "cacheWrite": 0.3 },
            "contextWindow": 1000000,
            "maxTokens": 65536
          },
          {
            "id": "openrouter/qwen/qwen3-coder",
            "name": "Qwen3 Coder",
            "reasoning": false,
            "input": ["text"],
            "cost": { "input": 0.22, "output": 1.0, "cacheRead": 0.05, "cacheWrite": 0.22 },
            "contextWindow": 262000,
            "maxTokens": 8192
          }
        ]
      }
    }
  }
}
