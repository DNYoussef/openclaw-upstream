{
  "name": "W3 - Service Health Dashboard",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "health-trigger",
      "name": "Every 30 Min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.TELEMETRY_API_URL }}/kpi/kpi_health?weeks=4&limit=10"
      },
      "id": "q-health",
      "name": "Query Health KPIs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 250]
    },
    {
      "parameters": {
        "url": "={{ $env.TELEMETRY_API_URL }}/kpi/kpi_automation?weeks=4&limit=10"
      },
      "id": "q-auto",
      "name": "Query Automation KPIs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 400]
    },
    {
      "parameters": {
        "jsCode": "const health = $('Query Health KPIs').first().json || {};\nconst auto = $('Query Automation KPIs').first().json || {};\n\nconst alerts = [];\nif ((health.checks_failed || 0) > 0) alerts.push({severity: 'high', msg: `${health.checks_failed} health checks failed today`});\nif ((health.crashes || 0) > 0) alerts.push({severity: 'critical', msg: `${health.crashes} service crashes today`});\nif ((auto.override_rate || 0) > 0.25) alerts.push({severity: 'high', msg: `Override rate ${(auto.override_rate*100).toFixed(0)}% exceeds 25% ceiling`});\nif ((auto.heartbeat_success_rate || 0) < 0.8) alerts.push({severity: 'high', msg: `Heartbeat success ${(auto.heartbeat_success_rate*100).toFixed(0)}% below 80%`});\n\nreturn [{json: {alerts, alert_count: alerts.length, all_green: alerts.length === 0}}];"
      },
      "id": "check-thresholds",
      "name": "Check Thresholds",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.all_green }}",
              "value2": false
            }
          ]
        }
      },
      "id": "has-alerts",
      "name": "Any Alerts?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [860, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.TELEMETRY_API_URL }}/telemetry",
        "method": "POST",
        "body": {
          "json": {
            "service": "infrastructure",
            "event_type": "health_alert",
            "payload": {
              "alerts": "={{ JSON.stringify($json.alerts) }}",
              "alert_count": "={{ $json.alert_count }}"
            }
          }
        }
      },
      "id": "emit-alert",
      "name": "Emit Health Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 200]
    }
  ],
  "connections": {
    "Every 30 Min": {
      "main": [
        [
          {
            "node": "Query Health KPIs",
            "type": "main",
            "index": 0
          },
          {
            "node": "Query Automation KPIs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Health KPIs": {
      "main": [
        [
          {
            "node": "Check Thresholds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Automation KPIs": {
      "main": [
        [
          {
            "node": "Check Thresholds",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Thresholds": {
      "main": [
        [
          {
            "node": "Any Alerts?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Any Alerts?": {
      "main": [
        [
          {
            "node": "Emit Health Alert",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
