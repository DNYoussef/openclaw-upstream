{
  "name": "P2 - Pilot Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "hours", "hoursInterval": 12 }]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WEBHOOK_BASE_URL || 'http://openclaw.railway.internal:18789' }}/webhook/pilot-pipeline",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.OPENCLAW_GATEWAY_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [{ "name": "action", "value": "check_pilot_repos" }]
        },
        "options": { "timeout": 60000 }
      },
      "name": "Check Pilot Repos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [470, 200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WEBHOOK_BASE_URL || 'http://openclaw.railway.internal:18789' }}/webhook/pilot-pipeline",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.OPENCLAW_GATEWAY_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [{ "name": "action", "value": "check_evidence_bundles" }]
        },
        "options": { "timeout": 60000 }
      },
      "name": "Check Evidence Bundles",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [470, 400]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      },
      "name": "Merge Pilot Data",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [690, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "" },
          "conditions": [
            {
              "id": "has-issues",
              "leftValue": "={{ $json.issues_count }}",
              "rightValue": 0,
              "operator": { "type": "number", "operation": "gt" }
            }
          ]
        }
      },
      "name": "Issues Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [910, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.WEBHOOK_BASE_URL || 'http://openclaw.railway.internal:18789' }}/webhook/pilot-pipeline",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "Bearer {{ $env.OPENCLAW_GATEWAY_TOKEN }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "action", "value": "generate_pilot_report" },
            { "name": "repos", "value": "={{ JSON.stringify($json.repos) }}" },
            { "name": "bundles", "value": "={{ JSON.stringify($json.evidence_summary) }}" }
          ]
        },
        "options": { "timeout": 60000 }
      },
      "name": "Generate Pilot Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1130, 200]
    },
    {
      "parameters": {},
      "name": "All Clear",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1130, 400]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          { "node": "Check Pilot Repos", "type": "main", "index": 0 },
          { "node": "Check Evidence Bundles", "type": "main", "index": 0 }
        ]
      ]
    },
    "Check Pilot Repos": {
      "main": [[{ "node": "Merge Pilot Data", "type": "main", "index": 0 }]]
    },
    "Check Evidence Bundles": {
      "main": [[{ "node": "Merge Pilot Data", "type": "main", "index": 1 }]]
    },
    "Merge Pilot Data": {
      "main": [[{ "node": "Issues Found?", "type": "main", "index": 0 }]]
    },
    "Issues Found?": {
      "main": [
        [{ "node": "Generate Pilot Report", "type": "main", "index": 0 }],
        [{ "node": "All Clear", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
