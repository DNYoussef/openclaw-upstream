{
  "name": "W8 - Notification Router",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "notify",
        "responseMode": "responseNode"
      },
      "id": "webhook",
      "name": "Notification Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300],
      "webhookId": "notify-router"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst severity = body.severity || 'low';\nconst source = body.source || 'unknown';\nconst message = body.message || '';\nconst agent = body.agent || '';\nreturn [{json: {severity, source, message, agent, timestamp: new Date().toISOString()}}];"
      },
      "id": "classify",
      "name": "Classify Severity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "rules": {
          "rules": [
            {
              "outputKey": "critical",
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.severity }}",
                    "rightValue": "critical",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "high",
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.severity }}",
                    "rightValue": "high",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            },
            {
              "outputKey": "medium",
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{ $json.severity }}",
                    "rightValue": "medium",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ]
              }
            }
          ],
          "fallbackOutput": "extra"
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "route",
      "name": "Route by Severity",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "url": "http://telemetry-api.railway.internal:8090/telemetry",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "contentType": "json",
        "jsonBody": "{\"service\": \"notifications\", \"event_type\": \"alert_critical\", \"payload\": {\"severity\": \"critical\", \"source\": \"={{ $json.source }}\", \"message\": \"={{ $json.message }}\", \"agent\": \"={{ $json.agent }}\", \"timestamp\": \"={{ $json.timestamp }}\"}}"
      },
      "id": "log-critical",
      "name": "Log Critical Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 100]
    },
    {
      "parameters": {
        "url": "http://telemetry-api.railway.internal:8090/telemetry",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "contentType": "json",
        "jsonBody": "{\"service\": \"notifications\", \"event_type\": \"alert_high\", \"payload\": {\"severity\": \"high\", \"source\": \"={{ $json.source }}\", \"message\": \"={{ $json.message }}\", \"agent\": \"={{ $json.agent }}\", \"timestamp\": \"={{ $json.timestamp }}\"}}"
      },
      "id": "log-high",
      "name": "Log High Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 250]
    },
    {
      "parameters": {
        "url": "http://telemetry-api.railway.internal:8090/telemetry",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "contentType": "json",
        "jsonBody": "{\"service\": \"notifications\", \"event_type\": \"alert_medium\", \"payload\": {\"severity\": \"medium\", \"source\": \"={{ $json.source }}\", \"message\": \"={{ $json.message }}\", \"agent\": \"={{ $json.agent }}\", \"timestamp\": \"={{ $json.timestamp }}\"}}"
      },
      "id": "log-medium",
      "name": "Log Medium Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 400]
    },
    {
      "parameters": {
        "url": "http://telemetry-api.railway.internal:8090/telemetry",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "contentType": "json",
        "jsonBody": "{\"service\": \"notifications\", \"event_type\": \"alert_low\", \"payload\": {\"severity\": \"low\", \"source\": \"={{ $json.source }}\", \"message\": \"={{ $json.message }}\", \"agent\": \"={{ $json.agent }}\", \"timestamp\": \"={{ $json.timestamp }}\"}}"
      },
      "id": "log-low",
      "name": "Log Low Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 550]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"status\":\"routed\",\"severity\":\"{{ $json.severity }}\"}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1100, 300]
    },
    {
      "parameters": {},
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [200, 700]
    },
    {
      "parameters": {
        "url": "http://telemetry-api.railway.internal:8090/telemetry",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "contentType": "json",
        "jsonBody": "{\"service\": \"n8n\", \"event_type\": \"workflow_error\", \"payload\": {\"workflow\": \"W8 - Notification Router\", \"error\": \"={{ $json.execution.error.message }}\", \"node\": \"={{ $json.execution.lastNodeExecuted }}\", \"timestamp\": \"={{ $now.toISO() }}\", \"execution_id\": \"={{ $json.execution.id }}\"}}"
      },
      "id": "post-error-telemetry",
      "name": "POST Error to Telemetry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 700]
    }
  ],
  "connections": {
    "Notification Webhook": {
      "main": [
        [
          {
            "node": "Classify Severity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Classify Severity": {
      "main": [
        [
          {
            "node": "Route by Severity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Route by Severity": {
      "main": [
        [
          {
            "node": "Log Critical Alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log High Alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Medium Alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Low Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Critical Alert": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log High Alert": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Medium Alert": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Low Alert": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Trigger": {
      "main": [
        [
          {
            "node": "POST Error to Telemetry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
