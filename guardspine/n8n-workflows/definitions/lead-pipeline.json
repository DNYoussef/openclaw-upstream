{
  "name": "P1 - Outreach Pipeline",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://openclaw.railway.internal:18789/webhook/outreach-pipeline",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.OPENCLAW_GATEWAY_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "check_response_signals"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "name": "Check Response Signals",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [470, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://openclaw.railway.internal:18789/webhook/outreach-pipeline",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.OPENCLAW_GATEWAY_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "check_landing_signups"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "name": "Check Landing Signups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://openclaw.railway.internal:18789/webhook/outreach-pipeline",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.OPENCLAW_GATEWAY_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "check_followups_due"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "name": "Check Follow-ups Due",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [470, 500]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      },
      "name": "Merge Signals + Signups",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [690, 200]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineAll",
        "options": {}
      },
      "name": "Merge All Sources",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [910, 350]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "id": "has-green-or-yellow",
              "leftValue": "={{ ($json.green_count || 0) + ($json.yellow_count || 0) + ($json.demo_count || 0) }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        }
      },
      "name": "Revenue Signals?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1130, 250]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://openclaw.railway.internal:18789/webhook/outreach-pipeline",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.OPENCLAW_GATEWAY_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "send_alert"
            },
            {
              "name": "signals",
              "value": "={{ JSON.stringify($json) }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "name": "Alert: Revenue Signal",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1350, 150]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": ""
          },
          "conditions": [
            {
              "id": "has-followups",
              "leftValue": "={{ $json.followups_due_count || 0 }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        }
      },
      "name": "Follow-ups Due?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1130, 450]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://openclaw.railway.internal:18789/webhook/outreach-pipeline",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer {{ $env.OPENCLAW_GATEWAY_TOKEN }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "action",
              "value": "draft_followups"
            },
            {
              "name": "prospects",
              "value": "={{ JSON.stringify($json.followups_due || []) }}"
            }
          ]
        },
        "options": {
          "timeout": 60000
        }
      },
      "name": "Draft Follow-ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1350, 350]
    },
    {
      "parameters": {},
      "name": "No Follow-ups",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1350, 550]
    },
    {
      "parameters": {},
      "name": "Quiet Period",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1560, 150]
    },
    {
      "parameters": {},
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [200, 600]
    },
    {
      "parameters": {
        "url": "http://telemetry-api.railway.internal:8090/telemetry",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "contentType": "json",
        "jsonBody": "{\"service\": \"n8n\", \"event_type\": \"workflow_error\", \"payload\": {\"workflow\": \"P1 - Outreach Pipeline\", \"error\": \"={{ $json.execution.error.message }}\", \"node\": \"={{ $json.execution.lastNodeExecuted }}\", \"timestamp\": \"={{ $now.toISO() }}\", \"execution_id\": \"={{ $json.execution.id }}\"}}"
      },
      "id": "post-error-telemetry",
      "name": "POST Error to Telemetry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 600]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Check Response Signals",
            "type": "main",
            "index": 0
          },
          {
            "node": "Check Landing Signups",
            "type": "main",
            "index": 0
          },
          {
            "node": "Check Follow-ups Due",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Response Signals": {
      "main": [
        [
          {
            "node": "Merge Signals + Signups",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Landing Signups": {
      "main": [
        [
          {
            "node": "Merge Signals + Signups",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Merge Signals + Signups": {
      "main": [
        [
          {
            "node": "Merge All Sources",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Follow-ups Due": {
      "main": [
        [
          {
            "node": "Merge All Sources",
            "type": "main",
            "index": 1
          }
        ]
      ]
    },
    "Merge All Sources": {
      "main": [
        [
          {
            "node": "Revenue Signals?",
            "type": "main",
            "index": 0
          },
          {
            "node": "Follow-ups Due?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Revenue Signals?": {
      "main": [
        [
          {
            "node": "Alert: Revenue Signal",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Quiet Period",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Follow-ups Due?": {
      "main": [
        [
          {
            "node": "Draft Follow-ups",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Follow-ups",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Trigger": {
      "main": [
        [
          {
            "node": "POST Error to Telemetry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
