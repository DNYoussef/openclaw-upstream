{
  "name": "W15 - Secrets Scanner",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      },
      "id": "daily-trigger",
      "name": "Daily 2 AM UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "http://telemetry-api.railway.internal:8090/query",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "contentType": "json",
        "jsonBody": "{\"query_name\": \"recent_telemetry\", \"params\": {\"limit\": 200}}"
      },
      "id": "fetch-telemetry",
      "name": "Fetch Recent Telemetry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "jsCode": "const items = $('Fetch Recent Telemetry').all().map(i => i.json);\n\nconst SECRET_PATTERNS = [\n  { name: 'postgres_uri', pattern: /postgres:\\/\\/[^\\s]+/i },\n  { name: 'jwt_token', pattern: /eyJhbG[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+/i },\n  { name: 'api_key_assignment', pattern: /API_KEY\\s*=\\s*['\"]?[A-Za-z0-9_-]{20,}/i },\n  { name: 'secret_assignment', pattern: /SECRET\\s*=\\s*['\"]?[A-Za-z0-9_-]{16,}/i },\n  { name: 'bearer_token', pattern: /Bearer\\s+[A-Za-z0-9_-]{20,}/i },\n  { name: 'aws_key', pattern: /AKIA[0-9A-Z]{16}/i },\n  { name: 'private_key', pattern: /-----BEGIN\\s+(RSA\\s+)?PRIVATE\\s+KEY-----/i },\n  { name: 'github_token', pattern: /gh[ps]_[A-Za-z0-9_]{36,}/i },\n  { name: 'slack_token', pattern: /xox[bpras]-[A-Za-z0-9-]+/i }\n];\n\nconst findings = [];\n\nfor (const evt of items) {\n  const payload = typeof evt.payload === 'string' ? evt.payload : JSON.stringify(evt.payload || {});\n  const fullText = payload + ' ' + (evt.event_type || '') + ' ' + (evt.service || '');\n\n  for (const sp of SECRET_PATTERNS) {\n    if (sp.pattern.test(fullText)) {\n      findings.push({\n        pattern: sp.name,\n        service: evt.service || 'unknown',\n        event_type: evt.event_type || 'unknown',\n        event_id: evt.id || 'unknown',\n        created_at: evt.created_at || evt.timestamp || 'unknown'\n      });\n    }\n  }\n}\n\nreturn [{\n  json: {\n    secrets_found: findings.length,\n    findings: findings,\n    events_scanned: items.length,\n    checked_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "scan-secrets",
      "name": "Scan for Secrets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $json.secrets_found }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "check-secrets",
      "name": "Secrets Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [860, 300]
    },
    {
      "parameters": {
        "url": "http://telemetry-api.railway.internal:8090/telemetry",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "contentType": "json",
        "jsonBody": "={\"service\": \"security\", \"event_type\": \"secret_leak_detected\", \"payload\": {\"secrets_found\": {{ $json.secrets_found }}, \"findings\": {{ JSON.stringify($json.findings) }}, \"events_scanned\": {{ $json.events_scanned }}, \"checked_at\": \"{{ $json.checked_at }}\"}}"
      },
      "id": "emit-leak-alert",
      "name": "Emit Secret Leak Alert",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 200]
    },
    {
      "parameters": {
        "url": "http://telemetry-api.railway.internal:8090/telemetry",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "contentType": "json",
        "jsonBody": "={\"service\": \"security\", \"event_type\": \"secrets_clean\", \"payload\": {\"events_scanned\": {{ $json.events_scanned }}, \"checked_at\": \"{{ $json.checked_at }}\"}}"
      },
      "id": "emit-clean",
      "name": "Emit Secrets Clean",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 400]
    },
    {
      "parameters": {},
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [200, 600]
    },
    {
      "parameters": {
        "url": "http://telemetry-api.railway.internal:8090/telemetry",
        "method": "POST",
        "sendBody": true,
        "specifyBody": "json",
        "contentType": "json",
        "jsonBody": "{\"service\": \"n8n\", \"event_type\": \"workflow_error\", \"payload\": {\"workflow\": \"W15 - Secrets Scanner\", \"error\": \"={{ $json.execution.error.message }}\", \"node\": \"={{ $json.execution.lastNodeExecuted }}\", \"timestamp\": \"={{ $now.toISO() }}\", \"execution_id\": \"={{ $json.execution.id }}\"}}"
      },
      "id": "post-error-telemetry",
      "name": "POST Error to Telemetry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 600]
    }
  ],
  "connections": {
    "Daily 2 AM UTC": {
      "main": [
        [
          {
            "node": "Fetch Recent Telemetry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Recent Telemetry": {
      "main": [
        [
          {
            "node": "Scan for Secrets",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Scan for Secrets": {
      "main": [
        [
          {
            "node": "Secrets Found?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Secrets Found?": {
      "main": [
        [
          {
            "node": "Emit Secret Leak Alert",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Emit Secrets Clean",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Trigger": {
      "main": [
        [
          {
            "node": "POST Error to Telemetry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
