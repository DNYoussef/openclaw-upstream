{
  "name": "W7 - GitHub PR Monitor",
  "nodes": [
    {
      "parameters": {
        "events": ["pull_request"],
        "owner": "={{ $env.GITHUB_OWNER }}",
        "repository": "={{ $env.GITHUB_REPO }}"
      },
      "id": "gh-webhook",
      "name": "GitHub PR Webhook",
      "type": "n8n-nodes-base.githubTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "const pr = $input.item.json.body || $input.item.json;\nconst action = pr.action || '';\nconst prNum = pr.number || pr.pull_request?.number || 0;\nconst title = pr.pull_request?.title || '';\nconst user = pr.pull_request?.user?.login || '';\nconst changedFiles = pr.pull_request?.changed_files || 0;\nconst additions = pr.pull_request?.additions || 0;\nconst deletions = pr.pull_request?.deletions || 0;\n\n// Only process opened/synchronize\nif (!['opened', 'synchronize', 'reopened'].includes(action)) {\n  return [];\n}\n\nreturn [{json: {action, pr_number: prNum, title, user, changed_files: changedFiles, additions, deletions, repo: pr.repository?.full_name || ''}}];"
      },
      "id": "parse-pr",
      "name": "Parse PR Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "url": "={{ $env.TELEMETRY_API_URL }}/telemetry",
        "method": "POST",
        "body": {
          "json": {
            "service": "github",
            "event_type": "pr_opened",
            "payload": {
              "pr_number": "={{ $json.pr_number }}",
              "title": "={{ $json.title }}",
              "user": "={{ $json.user }}",
              "changed_files": "={{ $json.changed_files }}",
              "additions": "={{ $json.additions }}",
              "repo": "={{ $json.repo }}"
            }
          }
        }
      },
      "id": "emit-pr-event",
      "name": "Log PR Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300]
    }
  ],
  "connections": {
    "GitHub PR Webhook": { "main": [[{ "node": "Parse PR Event", "type": "main", "index": 0 }]] },
    "Parse PR Event": { "main": [[{ "node": "Log PR Event", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
