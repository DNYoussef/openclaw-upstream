{
  "name": "Telemetry Event Collector",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "telemetry",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "telemetry-ingest"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-service",
              "leftValue": "={{ $json.body.service }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            },
            {
              "id": "check-event-type",
              "leftValue": "={{ $json.body.event_type }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "isNotEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "validate-fields",
      "name": "Validate Required Fields",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO telemetry_events (service, event_type, payload) VALUES ($1, $2, $3::jsonb) RETURNING id, ts",
        "options": {
          "queryReplacement": "={{ $json.body.service }},={{ $json.body.event_type }},={{ JSON.stringify($json.body.payload || {}) }}"
        }
      },
      "id": "insert-event",
      "name": "Insert Telemetry Event",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [700, 250],
      "credentials": {
        "postgres": {
          "id": "guardspine-postgres",
          "name": "GuardSpine Postgres"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'created', id: $json.id, ts: $json.ts }) }}",
        "options": {
          "responseCode": 201
        }
      },
      "id": "respond-success",
      "name": "Respond 201 Created",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [920, 250]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: 'error', message: 'Missing required fields: service, event_type' }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "respond-error",
      "name": "Respond 400 Bad Request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [700, 450]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Validate Required Fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Required Fields": {
      "main": [
        [
          {
            "node": "Insert Telemetry Event",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 400 Bad Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insert Telemetry Event": {
      "main": [
        [
          {
            "node": "Respond 201 Created",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "telemetry"
    },
    {
      "name": "infrastructure"
    }
  ]
}
