        {
            "name": "Prepare Evidence",
            "type": "n8n-nodes-base.code",
            "parameters": {
                "jsCode": "const items = $input.all(); const outputItems = items.map(i=>{const j={...i.json}; for (const k of Object.keys(j)) if (/token|key|secret|password|auth|bearer/i.test(k)) j[k]='[REDACTED]'; return j;}); const first=outputItems[0]||{}; return [{json:{workflow_name:$workflow.name, execution_id:String($execution.id), status:first.validation_ok===false?'validation_warning':'completed', items_count:items.length, finished_at:new Date().toISOString(), service_identity:'n8n-workflows', output_items:outputItems.slice(0,10), metadata:{node_count:$workflow.nodes?.length||0, alert_severity:first.alert_severity||'quiet', validation_errors:first.validation_errors||[]}}}];"
            },
            "id": "2e8a6255-146f-4b28-8fe7-6ea08ec0c916"
        },
        {
            "name": "Seal via GuardSpine",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "url": "http://guardspine-internal.railway.internal:8000/api/v1/ops/evidence/seal",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify($json) }}",
                "options": {
                    "timeout": 10000
                }
            },
            "id": "df4971ad-37dc-48ed-957d-8078186dcf73"
        },
        {
            "parameters": {
                "jsCode": "const j = $json || {};\nconst required = ['green_count','yellow_count','demo_count'];\nconst missing = required.filter(k => typeof j[k] === 'undefined');\nconst green = Number(j.green_count || 0);\nconst yellow = Number(j.yellow_count || 0);\nconst demo = Number(j.demo_count || 0);\nconst followups = Array.isArray(j.followups_due) ? j.followups_due : [];\nconst alert_severity = green > 0 ? 'urgent' : demo > 0 ? 'meeting' : yellow > 0 ? 'standard' : 'quiet';\nreturn [{json:{...j, validation_ok: missing.length===0, validation_errors: missing, alert_severity, followup_count: followups.length, evidence_scope:'pipeline_result'}}];"
            },
