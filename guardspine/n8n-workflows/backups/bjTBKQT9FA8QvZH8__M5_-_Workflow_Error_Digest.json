        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/telemetry",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "{\"service\":\"n8n\",\"event_type\":\"meta_cron\",\"payload\":{\"job\":\"M5 - Workflow Error Digest\"}}"
            },
            "name": "Log",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                710,
                300
            ],
            "id": "d82d0ef4-4964-4bde-a3f9-f610eab809ea"
        },
        {
            "parameters": {
                "jsCode": "const raw = $input.first().json || {};\nconst executions = Array.isArray(raw.data) ? raw.data : (Array.isArray(raw) ? raw : []);\nconst grouped = {};\nconst typeBreakdown = {};\n\nfunction classifyError(execution) {\n  const text = JSON.stringify(execution).toLowerCase();\n  if (/timeout|timed out|econnreset|socket hang up|network/.test(text)) return 'network_timeout';\n  if (/auth|unauthorized|forbidden|invalid api key|credentials?/.test(text)) return 'auth_failure';\n  if (/json|schema|validation|bad request|payload|parse/.test(text)) return 'data_error';\n  return 'unknown';\n}\n\nfor (const ex of executions) {\n  const wfName = ex.workflowName || ex.workflow?.name || ex.workflowId || 'unknown_workflow';\n  const nodeName = ex.data?.resultData?.lastNodeExecuted || ex.lastNodeExecuted || 'unknown_node';\n  const errType = classifyError(ex);\n  grouped[wfName] = grouped[wfName] || {count: 0, nodes: {}, sample_execution_ids: [], error_types: {}};\n  grouped[wfName].count += 1;\n  grouped[wfName].nodes[nodeName] = (grouped[wfName].nodes[nodeName] || 0) + 1;\n  grouped[wfName].error_types[errType] = (grouped[wfName].error_types[errType] || 0) + 1;\n  if (grouped[wfName].sample_execution_ids.length < 5) grouped[wfName].sample_execution_ids.push(ex.id);\n  typeBreakdown[errType] = (typeBreakdown[errType] || 0) + 1;\n}\n\nconst ranked = Object.entries(grouped).map(([workflow_name, stats]) => ({workflow_name, ...stats})).sort((a,b) => b.count - a.count);\nconst workflowsAboveThreshold = ranked.filter(r => r.count > 3).map(r => r.workflow_name);\n\nreturn [{json:{\n  stream: 'workflow_error_digest',\n  event_type: 'daily_error_digest',\n  workflow_name: $workflow.name,\n  execution_id: String($execution.id),\n  status: executions.length ? 'errors_found' : 'clean',\n  finished_at: new Date().toISOString(),\n  total_errors: executions.length,\n  unique_workflows: ranked.length,\n  top_failing_workflow: ranked[0]?.workflow_name || null,\n  workflows_above_threshold: workflowsAboveThreshold,\n  error_count_by_workflow: Object.fromEntries(ranked.map(r => [r.workflow_name, r.count])),\n  error_type_breakdown: typeBreakdown,\n  digest: ranked.slice(0, 10)\n}}];"
            },
            "name": "Prepare Evidence",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                960,
                300
            ],
            "onError": "continueRegularOutput",
            "id": "b1079002-0f22-487f-9f01-058ceb5919ab"
        },
