    "nodes": [
        {
            "name": "Schedule",
            "type": "n8n-nodes-base.scheduleTrigger",
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "cronExpression",
                            "expression": "30 7 * * 1,3,5"
                        }
                    ]
                }
            },
            "id": "a55784f5-3d2a-414e-83be-2fd85406dec7"
        },
        {
            "name": "Create Agent Task",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "url": "http://paperclip.railway.internal:3100/api/companies/75b694a8-5f7a-4b83-b12e-94fc378915c7/issues",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "{\"title\":\"[Agent] Draft Outreach Messages\",\"description\":\"Create draft-only outreach work items. Use structured prospect context when available. Decompose work as: (1) identify up to 3 due prospects, (2) collect evidence-backed research notes, (3) choose a messaging angle, (4) draft messages, (5) mark every draft pending_review. Do not send messages, update CRM status, or contact prospects. Every claim must be grounded in cited context.\",\"status\":\"todo\",\"priority\":\"medium\"}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "***REDACTED***"
                        }
                    ]
                },
                "options": {
                    "timeout": 15000
                },
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth"
            },
            "id": "708cf0e0-7604-44f4-bdef-8f44f3a6c282",
            "credentials": {
                "httpHeaderAuth": {
                    "id": "6Cliqjk7UlsZOGZJ",
                    "name": "paperclip-auth"
                }
            }
        },
        {
            "name": "Prepare Evidence",
            "type": "n8n-nodes-base.code",
            "parameters": {
                "jsCode": "const items = $input.all();\nconst outputItems = items.map(i => {\n  const j = {...i.json};\n  for (const k of Object.keys(j)) {\n    if (/token|key|secret|password|auth|bearer/i.test(k)) j[k] = '[REDACTED]';\n  }\n  return j;\n});\nconst first = outputItems[0] || {};\nreturn [{ json: {\n  workflow_name: $workflow.name,\n  execution_id: String($execution.id),\n  status: first.dispatch_status || 'created',\n  evidence_scope: first.evidence_scope || 'dispatch_only',\n  governance_note: first.governance_note || 'seal reflects dispatch only',\n  task_id: first.task_id || null,\n  items_count: items.length,\n  finished_at: new Date().toISOString(),\n  service_identity: 'n8n-workflows',\n  output_items: outputItems.slice(0, 10),\n  metadata: { node_count: $workflow.nodes?.length || 0 }\n}}];"
            },
            "id": "bd695c76-8acf-46e8-a4c9-b1a1f240c2e7"
        },
        {
            "name": "Seal via GuardSpine",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "url": "http://guardspine-internal.railway.internal:8000/api/v1/ops/evidence/seal",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify($json) }}",
                "options": {
                    "timeout": 10000
                },
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth"
            },
            "id": "fd436ad0-d7b2-4c7a-88e1-3ef8635c0c49",
            "credentials": {
                "httpHeaderAuth": {
                    "id": "sS3WHLXNPKSkpIC2",
                    "name": "openclaw-gateway-auth"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "const j = $json || {};\nconst taskId = j.id || j.issueId || j.data?.id || null;\nif (!taskId) { throw new Error('Paperclip task creation returned no task id'); }\nreturn [{json:{...j, task_id: taskId, dispatch_status:'created', evidence_scope:'dispatch_only', governance_note:'seal reflects task dispatch, not task completion'}}];"
            },
            "id": "Validate_Task_Response_mur5pv",
            "name": "Validate Task Response",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                520,
                300
            ]
        }
    ],
    "connections": {
        "Schedule": {
