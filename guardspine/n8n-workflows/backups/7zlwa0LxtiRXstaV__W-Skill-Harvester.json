    "name": "W-Skill-Harvester",
    "description": null,
    "active": false,
    "isArchived": false,
    "nodes": [
        {
            "name": "Schedule",
            "type": "n8n-nodes-base.scheduleTrigger",
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "cronExpression",
                            "expression": "0 7 * * *"
                        }
                    ]
                }
            },
            "id": "79bcca88-7750-4dd6-9b40-cc8e77cc5a54"
        },
        {
            "name": "Fetch Done Issues",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "method": "GET",
                "url": "http://paperclip.railway.internal:3100/api/companies/75b694a8-5f7a-4b83-b12e-94fc378915c7/issues",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "sendQuery": true,
                "queryParameters": {
                    "parameters": [
                        {
                            "name": "status",
                            "value": "done"
                        },
                        {
                            "name": "limit",
                            "value": "20"
                        }
                    ]
                },
                "options": {}
            },
            "id": "da5ab215-d508-479d-be46-49fd7f0a2923"
        },
        {
            "name": "Normalize Issues",
            "type": "n8n-nodes-base.code",
            "parameters": {
                "jsCode": "\nreturn $input.all().map(item => { const issue=item.json; const comments=Array.isArray(issue.comments)?issue.comments:[]; return {json:{issue_id:issue.id,title:issue.title,description:issue.description || '',comments,comment_count:comments.length,agent:issue.assigneeAgentId || 'unassigned',created_at:issue.createdAt,completed_at:issue.updatedAt}}; });\n"
            },
            "id": "794ca43b-7986-4017-97f5-1a08a3f3f70e"
        },
        {
            "name": "Classify Harvest Candidate",
            "type": "n8n-nodes-base.code",
            "parameters": {
                "jsCode": "\nconst out=[];\nfor (const item of $input.all()) { const j=item.json; const title=(j.title||'').toLowerCase(); const blob=(j.description||'').toLowerCase() + ' ' + title; const hasErrorRecovery=/error|fix|debug|incident/.test(title); const isMultiStep=(j.comment_count||0)>=3; const reusableSignal=/runbook|procedure|workflow|automation|retry|deploy|migrate|repair/.test(blob); const harvestable = hasErrorRecovery || isMultiStep || reusableSignal; if (harvestable) out.push({json:{...j,complexity_reason:isMultiStep?'multi_step':hasErrorRecovery?'error_recovery':'repeatable_pattern',harvest_confidence: reusableSignal || isMultiStep ? 'high' : 'medium'}}); }\nreturn out.length?out:[{json:{skip:true,reason:'no complex issues found'}}];\n"
            },
            "id": "56c78f88-eb60-43b6-8e2e-2c91c627ad3d"
        },
        {
            "name": "Skip Check",
            "type": "n8n-nodes-base.if",
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "strict"
                    },
                    "conditions": [
                        {
                            "id": "skip-check",
                            "leftValue": "={{ $json.skip }}",
                            "rightValue": true,
                            "operator": {
                                "type": "boolean",
                                "operation": "notTrue"
                            }
                        }
                    ],
                    "combinator": "and"
                }
            },
            "id": "cdea3cdc-8edf-47ee-9bc4-cf605386dd5f"
        },
        {
            "name": "Extract Steps via LLM",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "method": "POST",
                "url": "http://litellm.railway.internal:4000/v1/chat/completions",
                "authentication": "genericCredentialType",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({model:\"gemini-flash\",messages:[{role:\"system\",content:\"Return ONLY JSON with keys: skill_name, description, steps (array), common_errors (array), evidence_points (array), confidence. Extract only reusable procedures.\"},{role:\"user\",content:\"Issue title: \" + $json.title + \"\\nDescription: \" + $json.description + \"\\nComments: \" + JSON.stringify($json.comments).substring(0, 2000) + \"\\nComplexity: \" + $json.complexity_reason + \"\\nAgent: \" + $json.agent}],max_tokens:1000}) }}",
                "options": {},
                "genericAuthType": "httpHeaderAuth"
            },
            "id": "e1945ae2-e5ec-4911-9d5d-07bfd51c6b00"
        },
        {
            "name": "Format Skill",
            "type": "n8n-nodes-base.code",
            "parameters": {
                "jsCode": "\n            const raw=$json.choices?.[0]?.message?.content || '{}'; let parsed={}, errors=[]; try { const m=raw.match(/\\{[\\s\\S]*\\}/); parsed=JSON.parse(m?m[0]:raw);} catch(e){ errors.push('parse_error'); parsed={}; }\n            const src=$('Classify Harvest Candidate').first().json;\n            const skillName=String(parsed.skill_name || src.title || 'unknown').toLowerCase().replace(/[^a-z0-9\\s-]/g,'').replace(/\\s+/g,'-').substring(0,40);\n            const steps=Array.isArray(parsed.steps)?parsed.steps:[]; if(steps.length<3) errors.push('insufficient_steps'); if(!parsed.description) errors.push('missing_description');\n            const md=['# '+skillName,'','## Description',parsed.description || '','', '## Procedure', ...steps.map((s,i)=>`${i+1}. ${s}`), '', '## Common Errors', ...(Array.isArray(parsed.common_errors)?parsed.common_errors:['None captured']).map(x=>'- '+x), '', '## Evidence Metadata', '- source_issue: ' + src.title, '- complexity_reason: ' + src.complexity_reason, '- confidence: ' + (parsed.confidence || src.harvest_confidence)].join('\n');\n            return [{json:{skill_name:skillName,skill_content:md,issue_title:src.title,created_date:new Date().toISOString().split('T')[0],summary:`Skill harvested from: ${src.title}`,validation_errors:errors,status:errors.length?'blocked':'ready'}}];\n"
            },
            "id": "f482ea7a-e2a3-48f2-a632-7f2e5c5746cc"
        },
        {
            "name": "Skill OK?",
            "type": "n8n-nodes-base.if",
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "strict"
                    },
                    "conditions": [
                        {
                            "id": "ok",
                            "leftValue": "={{ $json.status }}",
                            "rightValue": "ready",
                            "operator": {
                                "type": "string",
                                "operation": "equals"
                            }
                        }
                    ],
                    "combinator": "and"
                }
            },
            "id": "ff09b47d-f709-4afe-a4bf-0b1882fa7e6d"
        },
        {
            "name": "Store to Memory-MCP",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "method": "POST",
                "url": "http://memory-mcp.railway.internal:8080/tools/memory_store",
                "authentication": "noAuth",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({text: 'Skill harvested: ' + $json.skill_name + '\\n\\n' + $json.skill_content, metadata: {type: 'auto_skill', skill_name: $json.skill_name, source_issue: $json.issue_title, created: $json.created_date, project: 'guardspine'}}) }}",
                "options": {},
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "***REDACTED***"
                        }
                    ]
                }
            },
            "id": "7a2ceb07-f6c2-4ce8-b3e3-2a4a2ef6c4ff"
        },
        {
            "name": "Notify Blocked",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "method": "POST",
                "url": "https://slack.com/api/chat.postMessage",
                "authentication": "genericCredentialType",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({channel:\"C0AKXAYJ41W\", text:\"\u26a0\ufe0f Skill harvester blocked for issue: \" + ($json.issue_title || \"unknown\") + \" \u2014 \" + (($json.validation_errors || []).join(\", \") || \"validation_failed\")}) }}",
                "options": {},
                "genericAuthType": "httpHeaderAuth"
            },
            "id": "67909057-e510-46f9-b0b0-9e4c9480c257"
        },
        {
            "name": "Seal Evidence",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "method": "POST",
                "url": "http://guardspine-internal.railway.internal:8000/api/v1/ops/evidence/seal",
                "authentication": "noAuth",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({stream_key: 'skill-harvester', execution_id: 'sh-' + Date.now(), event_type: 'skill_created', payload: {skill_name: $json.skill_name, source: $json.issue_title}, meta: {workflow: 'W-Skill-Harvester'}}) }}",
                "options": {}
            },
            "id": "4af0df78-d34d-4b60-889c-ae19e5b39349"
        }
    ],
