                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({stream_key: 'capacity-monitor', execution_id: 'cap-' + Date.now(), event_type: 'capacity_snapshot', payload: {daily_spend_usd: $json.daily_spend_usd, litellm_models: $json.litellm.total_models, down_services: $json.down_services, alerts_count: $json.alerts.length, metrics_valid: $json.metrics_valid}, meta: {workflow: 'M32-Capacity-Monitor'}}) }}",
                "options": {}
            },
            "id": "d9c3f26e-b76f-435f-8252-40f3fc47f210"
        },
        {
            "name": "Fetch Service Health",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                760,
                420
            ],
            "parameters": {
                "method": "GET",
                "url": "={{ $json.url }}",
                "authentication": "none",
                "options": {
                    "timeout": 5000,
                    "ignoreResponseCode": true
                }
