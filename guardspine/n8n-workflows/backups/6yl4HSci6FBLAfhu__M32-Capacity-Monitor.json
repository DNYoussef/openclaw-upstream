            "id": "ada29275-b4b8-49ea-8008-5fa9f5cc974a"
        },
        {
            "name": "Validate Metrics",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1250,
                280
            ],
            "parameters": {
                "jsCode": "const metrics = $json;\nconst validation_errors = [];\nif (!metrics.timestamp) validation_errors.push('missing_timestamp');\nif (!metrics.litellm || typeof metrics.litellm.total_models !== 'number') validation_errors.push('missing_litellm_models');\nif (!Array.isArray(metrics.service_health)) validation_errors.push('missing_service_health');\nreturn [{json:{...metrics, validation_errors, metrics_valid: validation_errors.length === 0}}];"
            },
            "id": "68ce9847-0bec-42d2-b6f4-4bf7d9e5b321"
        }
