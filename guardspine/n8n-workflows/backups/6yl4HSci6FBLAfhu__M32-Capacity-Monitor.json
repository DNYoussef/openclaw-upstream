        {
            "name": "Check All Services",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                220,
                300
            ],
            "parameters": {
                "jsCode": "const services = [\n  {name: 'openclaw', url: 'http://openclaw.railway.internal:18789/health'},\n  {name: 'paperclip', url: 'http://paperclip.railway.internal:3100/health'},\n  {name: 'n8n', url: 'http://n8n.railway.internal:5678/healthz'},\n  {name: 'litellm', url: 'http://litellm.railway.internal:4000/health'},\n  {name: 'telemetry-api', url: 'http://telemetry-api.railway.internal:8090/health'},\n  {name: 'guardspine-internal', url: 'http://guardspine-internal.railway.internal:8000/health'},\n  {name: 'decision-engine', url: 'http://decision-engine.railway.internal:8091/health'},\n  {name: 'memory-mcp', url: 'http://memory-mcp.railway.internal:8080/health'}\n];\nreturn services.map((service) => ({ json: service }));"
            },
            "id": "7c9ec8f0-cd23-4e5e-ba82-3bd4d85e29bb"
        },
        {
            "name": "Aggregate Metrics",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                500,
                0
            ],
            "parameters": {
                "jsCode": "const now = new Date().toISOString();\nconst spendRaw = $('Collect LiteLLM Spend').first().json || {};\nconst modelRaw = $('Collect LiteLLM Models').first().json || {};\nconst serviceItems = $('Fetch Service Health').all().map(i => i.json || {});\n\nconst spendEntries = Array.isArray(spendRaw) ? spendRaw : (Array.isArray(spendRaw.data) ? spendRaw.data : (Array.isArray(spendRaw.response) ? spendRaw.response : []));\nconst models = Array.isArray(modelRaw.data) ? modelRaw.data : (Array.isArray(modelRaw.models) ? modelRaw.models : (Array.isArray(modelRaw) ? modelRaw : []));\nconst healthyEndpoints = Array.isArray(spendRaw.healthy_endpoints) ? spendRaw.healthy_endpoints.length : Number(spendRaw.healthy_count || 0);\nconst unhealthyEndpoints = Array.isArray(spendRaw.unhealthy_endpoints) ? spendRaw.unhealthy_endpoints.length : Number(spendRaw.unhealthy_count || 0);\n\nconst serviceHealth = serviceItems.map(item => ({\n  name: item.name || 'unknown',\n  url: item.url || null,\n  ok: item.statusCode ? item.statusCode < 400 : !(item.error || item.status === 'error'),\n  statusCode: item.statusCode || null\n}));\n\nreturn [{json: {\n  timestamp: now,\n  litellm: {\n    total_models: models.length,\n    model_names: models.map(m => m.model_name || m.id || m.name).filter(Boolean),\n    unhealthy_endpoints: unhealthyEndpoints,\n    healthy_endpoints: healthyEndpoints,\n    spend_tracking_available: false,\n    spend_source: 'litellm_health_fallback'\n  },\n  spend_entries: spendEntries,\n  service_health: serviceHealth,\n  services_checked: serviceHealth.length\n}}];"
            },
            "id": "e43db933-5858-448a-a0a8-001a5faa72db"
        },
        {
            "name": "Check Thresholds",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                720,
                0
            ],
            "parameters": {
                "jsCode": "const metrics = $json;\nconst alerts = [];\nconst spendEntries = Array.isArray(metrics.spend_entries) ? metrics.spend_entries : [];\nconst todaySpend = spendEntries.reduce((sum, e) => sum + Number(e.spend || e.amount || 0), 0);\nconst downServices = (metrics.service_health || []).filter(s => s.ok === false);\n\nif (!metrics.metrics_valid) {\n  alerts.push({severity: 'MEDIUM', service: 'capacity-monitor', message: 'Metric validation failed: ' + (metrics.validation_errors || []).join(', ')});\n}\nif (downServices.length > 0) {\n  alerts.push({severity: 'HIGH', service: 'railway', message: 'Services down: ' + downServices.map(s => s.name + (s.statusCode ? ' (' + s.statusCode + ')' : '')).join(', ')});\n}\nif (metrics.litellm.unhealthy_endpoints > 0) {\n  alerts.push({severity: 'HIGH', service: 'litellm', message: metrics.litellm.unhealthy_endpoints + ' unhealthy LiteLLM endpoints detected'});\n}\nif (todaySpend > 8) {\n  alerts.push({severity: 'HIGH', service: 'litellm', message: 'Daily LLM spend: $' + todaySpend.toFixed(2) + ' (threshold: $8.00)'});\n}\n\nreturn [{json: {\n  ...metrics,\n  alerts,\n  has_alerts: alerts.length > 0,\n  daily_spend_usd: todaySpend,\n  down_services: downServices.map(s => s.name)\n}}];"
            },
            "id": "6dbd2c37-7b50-438c-91fc-e33bbe685331"
        },
        {
            "name": "Has Alerts?",
