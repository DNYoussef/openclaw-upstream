            "position": [
                200,
                300
            ]
        },
        {
            "parameters": {
                "url": "http://paperclip.railway.internal:3100/api/companies/guardspine/issues?status=in_progress&limit=200",
                "authentication": "genericCredentialType",
                "genericAuthType": "httpHeaderAuth",
                "options": {}
            },
            "id": "fetch-issues",
            "name": "Fetch In-Progress Issues",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                420,
                300
            ],
            "credentials": {
                "httpHeaderAuth": {
                    "id": "AXD4VXk71OMLdnex",
                    "name": "Paperclip API Key"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "const items = $('Fetch In-Progress Issues').all();\nconst now = new Date();\nconst FIVE_DAYS_MS = 5 * 24 * 60 * 60 * 1000;\nconst followUps = [];\n\nfor (const item of items) {\n  const issue = item.json;\n  const createdAt = new Date(issue.created_at || issue.createdAt || 0);\n  const daysSinceCreation = (now - createdAt) / (24 * 60 * 60 * 1000);\n\n  if (daysSinceCreation < 5) continue;\n\n  const comments = issue.comments || [];\n  let lastContactDate = createdAt;\n  let followUpCount = 0;\n\n  for (const c of comments) {\n    const commentDate = new Date(c.created_at || c.createdAt || 0);\n    if (commentDate > lastContactDate) lastContactDate = commentDate;\n    const body = (c.body || '').toLowerCase();\n    if (body.includes('follow-up') || body.includes('follow_up') || body.includes('followup')) {\n      followUpCount++;\n    }\n  }\n\n  const desc = (issue.description || '').toLowerCase();\n  const countMatch = desc.match(/follow_up_count[\"']?\\s*[:=]\\s*(\\d+)/);\n  if (countMatch) followUpCount = Math.max(followUpCount, parseInt(countMatch[1], 10));\n\n  if (followUpCount >= 2) continue;\n\n  const daysSinceLastContact = (now - lastContactDate) / (24 * 60 * 60 * 1000);\n  if (daysSinceLastContact < 5) continue;\n\n  let prospectName = 'unknown';\n  let company = 'unknown';\n  try {\n    const jsonMatch = (issue.description || '').match(/\\{[\\s\\S]*\\}/);\n    if (jsonMatch) {\n      const parsed = JSON.parse(jsonMatch[0]);\n      prospectName = parsed.name || parsed.prospect_name || 'unknown';\n      company = parsed.company || parsed.organization || 'unknown';\n    }\n  } catch (e) {}\n\n  followUps.push({\n    issue_id: issue.id || issue._id,\n    prospect_name: prospectName,\n    company: company,\n    days_since_last_contact: Math.round(daysSinceLastContact),\n    follow_up_number: followUpCount + 1\n  });\n}\n\nreturn [{ json: { follow_ups: followUps, follow_ups_needed: followUps.length } }];"
            },
            "id": "filter-candidates",
            "name": "Filter Follow-Up Candidates",
            "type": "n8n-nodes-base.code",
