                    "body": "={\"model\":\"llama3.2\",\"messages\":[{\"role\":\"system\",\"content\":\"You are a Four-Fit scoring analyst. Score Model-Market Fit 0-10. Return JSON: {\\\"fit\\\":\\\"MM\\\",\\\"score\\\":0,\\\"confidence\\\":0.5,\\\"trend\\\":\\\"stable\\\",\\\"rationale\\\":\\\"string\\\",\\\"gaps\\\":[]}\"},{\"role\":\"user\",\"content\":\"Score MM Fit for GuardSpine. Rubric: {{ JSON.stringify($('Build Scoring Context').first().json.fits.MM.rubric_questions) }}. Return only valid JSON.\"}],\"temperature\":0.2}",
