        {
            "name": "Build Scoring Context",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                500,
                300
            ],
            "parameters": {
                "jsCode": "const now = new Date();\nconst thirtyDaysAgo = new Date(now - 30 * 24 * 60 * 60 * 1000).toISOString();\n\nconst scoringContext = {\n  scoring_period: { start: thirtyDaysAgo, end: now.toISOString() },\n  fits: {\n    MP: {\n      name: 'Market-Problem Fit',\n      rubric_questions: [\n        'Do target customers spontaneously describe the problem without prompting?',\n        'Is the problem ranked top 3 priority by >50% of ICP interviews?',\n        'Are customers paying for workarounds or inferior solutions?',\n        'Does the problem recur frequently (weekly/monthly)?',\n        'Do customers express urgency about solving this now?'\n      ],\n      recent_evidence: [],\n      weights: [0.25, 0.25, 0.2, 0.15, 0.15]\n    },\n    PC: {\n      name: 'Problem-Channel Fit',\n      rubric_questions: [\n        'Are target customers reachable via identified channels at acceptable CAC?',\n        'Do channel conversion rates meet benchmarks for the category?',\n        'Is the channel scalable to 10x current volume without degrading?',\n        'Do channel-acquired customers have LTV matching ICP definition?',\n        'Is channel dependence diversified (no single channel >60%)?'\n      ],\n      recent_evidence: [],\n      weights: [0.25, 0.2, 0.2, 0.2, 0.15]\n    },\n    CM: {\n      name: 'Channel-Model Fit',\n      rubric_questions: [\n        'Does ACV support the cost of the primary acquisition channel?',\n        'Is payback period <12 months on primary channel?',\n        'Does sales motion match channel expectations (PLG vs high-touch)?',\n        'Is gross margin sufficient to fund channel at scale (>60%)?',\n        'Do channel economics improve with volume?'\n      ],\n      recent_evidence: [],\n      weights: [0.3, 0.25, 0.2, 0.15, 0.1]\n    },\n    MM: {\n      name: 'Model-Market Fit',\n      rubric_questions: [\n        'Is TAM >$100M and SAM addressable within 3 years?',\n        'Does pricing model align with how the market buys?',\n        'Is NRR >100% indicating expansion within accounts?',\n        'Do market dynamics favor the model?',\n        'Is competitive moat strengthening over time?'\n      ],\n      recent_evidence: [],\n      weights: [0.2, 0.25, 0.25, 0.15, 0.15]\n    }\n  },\n  trigger_source: $input.first()?.json?.body?.trigger || 'schedule'\n};\n\nreturn [{ json: scoringContext }];"
            },
            "id": "973f082c-d908-4038-a6ce-437b83389c98"
        },
