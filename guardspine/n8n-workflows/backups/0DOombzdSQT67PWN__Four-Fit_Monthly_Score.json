        {
            "name": "Combine Fit Scores",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1000,
                400
            ],
            "parameters": {
                "jsCode": "const allItems = $input.all();\nconst fitMap = {};\n\nfor (const item of allItems) {\n  try {\n    const data = item.json;\n    const content = data.choices?.[0]?.message?.content || '{}';\n    const parsed = typeof content === 'string' ? JSON.parse(content) : content;\n    if (parsed.fit) fitMap[parsed.fit] = parsed;\n  } catch(e) {}\n}\n\nconst now = new Date();\nconst fitScores = Object.values(fitMap);\nconst overallScore = fitScores.length > 0 ? fitScores.reduce((s, f) => s + (f.score || 5), 0) / fitScores.length : 5;\n\nconst scorecard = {\n  scored_at: now.toISOString(),\n  period_label: now.toLocaleString('default', { month: 'long' }) + ' ' + now.getFullYear(),\n  overall_score: Math.round(overallScore * 10) / 10,\n  fits: {\n    MP: fitMap.MP || { score: null, confidence: 0, trend: 'unknown', rationale: 'Not scored', gaps: [] },\n    PC: fitMap.PC || { score: null, confidence: 0, trend: 'unknown', rationale: 'Not scored', gaps: [] },\n    CM: fitMap.CM || { score: null, confidence: 0, trend: 'unknown', rationale: 'Not scored', gaps: [] },\n    MM: fitMap.MM || { score: null, confidence: 0, trend: 'unknown', rationale: 'Not scored', gaps: [] }\n  },\n  weakest_fit: Object.entries(fitMap).sort((a,b) => (a[1].score||10)-(b[1].score||10))[0]?.[0] || 'unknown',\n  recommended_focus: 'Address weakest fit before scaling channels'\n};\n\nreturn [{ json: scorecard }];"
            },
            "id": "b41d77d6-5a24-4e0b-8119-1b50bba49998"
        },
