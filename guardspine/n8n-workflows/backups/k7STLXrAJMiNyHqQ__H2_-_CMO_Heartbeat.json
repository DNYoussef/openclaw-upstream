        {
            "name": "Fetch Open Issues",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                470,
                380
            ],
            "id": "fetch-open-aaf01077",
            "parameters": {
                "method": "GET",
                "url": "http://paperclip.railway.internal:3100/api/companies/75b694a8-5f7a-4b83-b12e-94fc378915c7/issues?limit=100",
                "sendHeaders": true,
                "headerParameters": {
