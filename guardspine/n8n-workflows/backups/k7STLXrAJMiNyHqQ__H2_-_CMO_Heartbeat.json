        {
            "name": "Analyze Heartbeat",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                730,
                300
            ],
            "id": "analyze-d0695b42",
            "parameters": {
                "jsCode": "const status = $(\"Fetch Pipeline Status\").first().json || {};\nconst rawIssues = $json;\nconst issues = Array.isArray(rawIssues) ? rawIssues : (Array.isArray(rawIssues.items) ? rawIssues.items : (Array.isArray(rawIssues.data) ? rawIssues.data : []));\nconst title = '[Heartbeat] CMO outreach pipeline check and message review';\nconst openMatch = issues.filter(i => ['todo','backlog','in_progress'].includes(i.status) && i.title === title);\nconst lanes = status.lanes || status.pipeline || status.by_lane || {};\nconst laneEntries = Array.isArray(lanes) ? lanes : Object.entries(lanes).map(([lane, value]) => ({ lane, ...(typeof value === 'number' ? { count: value } : value) }));\nconst waiting = Number(status.followups_due || status.overdue_followups || 0);\nconst signals = Number(status.response_signals || status.responses_last_24h || 0);\nconst total = Number(status.total || status.total_prospects || laneEntries.reduce((sum, l) => sum + Number(l.count || l.total || 0), 0));\nconst priority = waiting > 10 || signals > 5 ? 'high' : total === 0 ? 'high' : 'medium';\nconst shouldCreate = openMatch.length === 0;\nconst summary = { totalProspects: total, followupsDue: waiting, responseSignals: signals, laneSummary: laneEntries.slice(0,4) };\nconst description = [\n  'Automated CMO heartbeat summary.',\n  '',\n  'Total prospects: ' + total,\n  'Follow-ups due: ' + waiting,\n  'Response signals (recent): ' + signals,\n  'Priority rationale: ' + priority,\n  '',\n  'Lane summary:',\n  ...summary.laneSummary.map(l => '- ' + (l.lane || l.name || 'lane') + ': ' + JSON.stringify(l)),\n].join('\\n');\nreturn [{ json: { shouldCreate, priority, dedupReason: openMatch.length ? 'existing_open_heartbeat' : null, summary, taskPayload: { title, description, status: 'todo', priority } } }];"
            }
        },
        {
            "name": "Should Create Task?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2.2,
            "position": [
