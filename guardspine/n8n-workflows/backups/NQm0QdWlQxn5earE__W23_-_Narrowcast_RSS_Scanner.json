        },
        {
            "parameters": {
                "url": "https://www.reddit.com/r/devops+netsec+programming/search.json?q=code+governance+audit+trail&sort=new&t=week&limit=10"
            },
            "id": "fetch-reddit",
            "name": "Fetch Reddit JSON",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                640,
                300
            ]
        },
        {
            "parameters": {
                "url": "https://dev.to/search/feed_content?per_page=10&search_fields=title&sort_by=published_at&sort_direction=desc&class_name=Article&q=code+governance+audit+trail+compliance"
            },
            "id": "fetch-devto",
            "name": "Fetch Dev.to",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                860,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "// Collect items from all three sources\nconst hnRaw = $('Fetch HN RSS').first().json;\nconst redditRaw = $('Fetch Reddit JSON').first().json;\nconst devtoRaw = $('Fetch Dev.to').first().json;\n\n// Parse HN RSS (hnrss.org returns XML parsed by n8n into json)\n// n8n HTTP node auto-parses; items may be at various paths\nconst hnItems = [];\ntry {\n  const channel = hnRaw?.rss?.channel || hnRaw?.channel || {};\n  const rawItems = channel.item || [];\n  const items = Array.isArray(rawItems) ? rawItems : [rawItems];\n  for (const h of items) {\n    hnItems.push({\n      title: h.title || '',\n      description: h.description || '',\n      link: h.link || '',\n      source: 'hackernews'\n    });\n  }\n} catch (e) { /* HN parse failed, continue */ }\n\n// Parse Reddit JSON\nconst redditItems = [];\ntry {\n  const children = redditRaw?.data?.children || [];\n  for (const c of children) {\n    const d = c.data || {};\n    redditItems.push({\n      title: d.title || '',\n      description: d.selftext || '',\n      link: d.url || ('https://reddit.com' + (d.permalink || '')),\n      source: 'reddit'\n    });\n  }\n} catch (e) { /* Reddit parse failed, continue */ }\n\n// Parse Dev.to JSON\nconst devtoItems = [];\ntry {\n  const results = devtoRaw?.result || devtoRaw || [];\n  const articles = Array.isArray(results) ? results : [];\n  for (const a of articles) {\n    devtoItems.push({\n      title: a.title || a.name || '',\n      description: a.tag_list || a.body_text || '',\n      link: a.path ? ('https://dev.to' + a.path) : (a.url || ''),\n      source: 'devto'\n    });\n  }\n} catch (e) { /* Dev.to parse failed, continue */ }\n\nconst allItems = [...hnItems, ...redditItems, ...devtoItems];\n\n// Keyword scoring\nconst KEYWORDS = {\n  'code review': 10,\n  'code governance': 15,\n  'governance': 8,\n  'audit trail': 10,\n  'audit': 5,\n  'evidence bundle': 15,\n  'compliance': 5,\n  'soc 2': 8,\n  'dora': 8,\n  'hipaa': 5,\n  'ai code': 8,\n  'ai generated code': 10,\n  'pr review': 8,\n  'pull request review': 8,\n  'rubber stamp': 10,\n  'supply chain security': 8,\n  'code signing': 5,\n  'attestation': 10,\n  'sbom': 5\n};\n\nconst scored = allItems.map(item => {\n  const text = (item.title + ' ' + (item.description || '')).toLowerCase();\n  let score = 0;\n  const matched = [];\n  for (const [kw, points] of Object.entries(KEYWORDS)) {\n    if (text.includes(kw.toLowerCase())) {\n      score += points;\n      matched.push(kw);\n    }\n  }\n  return { ...item, score, matched_keywords: matched };\n});\n\nconst relevant = scored.filter(s => s.score >= 15);\nrelevant.sort((a, b) => b.score - a.score);\n\nreturn [{ json: {\n  total_scanned: scored.length,\n  relevant_found: relevant.length,\n  scan_timestamp: new Date().toISOString(),\n  threads: relevant.slice(0, 10).map(t => ({\n    title: t.title,\n    url: t.link,\n    source: t.source,\n    score: t.score,\n    keywords: t.matched_keywords\n  }))\n}}];"
            },
