                "url": "http://telemetry-api.railway.internal:8090/telemetry",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "={\"service\": \"loop-detector\", \"event_type\": \"runaway_detected\", \"payload\": {\"alert_count\": {{ $json.alert_count }}, \"alerts\": {{ JSON.stringify($json.alerts) }}, \"checked_events\": {{ $json.checked_events }}, \"checked_heartbeats\": {{ $json.checked_heartbeats }}, \"timestamp\": \"{{ $json.timestamp }}\"}}"
            },
