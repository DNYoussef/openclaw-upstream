                        }
                    ]
                }
            },
            "name": "Every 15 Minutes",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                200,
                300
            ],
            "id": "41492ebb-4856-438c-b6c0-ecc8c79d55c7"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/query",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "{\"query_name\": \"recent_telemetry\", \"params\": {\"limit\": 200}}"
            },
            "name": "Fetch Recent Telemetry",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                420,
                300
            ],
            "id": "8bc1078e-3fb9-4e8f-942e-7e7c4d40b7bb"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/query",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "{\"query_name\": \"agent_heartbeats\", \"params\": {\"hours\": \"1 hour\"}}"
            },
            "name": "Fetch Agent Heartbeats",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                640,
                300
            ],
            "id": "cfa10b63-3bb3-4505-85dd-a9a5553f6110"
        },
        {
            "parameters": {
                "jsCode": "const telemetry = $('Fetch Recent Telemetry').first().json;\nconst heartbeats = $('Fetch Agent Heartbeats').first().json;\n\nconst events = telemetry.rows || [];\nconst hb = heartbeats.rows || [];\n\nconst alerts = [];\n\n// Check 1: Error event spike (>15 errors in last 200 events = likely loop)\nconst errors = events.filter(e => e.event_type === 'workflow_error' || (e.event_type || '').includes('error'));\nif (errors.length > 15) {\n  alerts.push({type: 'error_spike', count: errors.length, threshold: 15});\n}\n\n// Check 2: Agent failure spike (>5 failures in 1 hour for any agent)\nconst agentFailures = {};\nfor (const h of hb) {\n  if (h.status !== 'succeeded') {\n    agentFailures[h.name] = (agentFailures[h.name] || 0) + 1;\n  }\n}\nfor (const [agent, fails] of Object.entries(agentFailures)) {\n  if (fails > 5) {\n    alerts.push({type: 'agent_loop', agent, failures: fails, threshold: 5});\n  }\n}\n\n// Check 3: Billing errors (any 402 in recent events)\nconst billing = events.filter(e => {\n  const p = typeof e.payload === 'string' ? e.payload : JSON.stringify(e.payload || {});\n  return p.includes('402') || p.includes('billing') || p.includes('credits');\n});\nif (billing.length > 0) {\n  alerts.push({type: 'billing_alert', count: billing.length});\n}\n\n// Check 4: Telemetry flood (>100 events from same service in 200 events = runaway)\nconst serviceCounts = {};\nfor (const e of events) {\n  serviceCounts[e.service] = (serviceCounts[e.service] || 0) + 1;\n}\nfor (const [svc, count] of Object.entries(serviceCounts)) {\n  if (count > 100) {\n    alerts.push({type: 'telemetry_flood', service: svc, count, threshold: 200});\n  }\n}\n\nreturn [{json: {\n  alert_count: alerts.length,\n  alerts: alerts,\n  checked_events: events.length,\n  checked_heartbeats: hb.length,\n  timestamp: new Date().toISOString()\n}}];"
            },
            "name": "Detect Loops",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                860,
                300
            ],
            "id": "af43555f-4f03-404f-9684-9a9f4af0e51e"
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "strict"
                    },
                    "conditions": [
                        {
                            "id": "cond-alerts",
                            "leftValue": "={{ $json.alert_count }}",
                            "rightValue": 0,
                            "operator": {
                                "type": "number",
                                "operation": "gt"
                            }
                        }
                    ],
                    "combinator": "and"
                }
            },
            "name": "Alerts Detected?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                1080,
