                "parameters": {
                    "jsCode": "const items = $input.all().map(i => i.json);\nconst normalized = [];\nlet latestRelease = null;\nfor (const item of items) {\n  if (item && item.tag_name) {\n    latestRelease = {tag_name: item.tag_name, name: item.name || item.tag_name, published_at: item.published_at || null, html_url: item.html_url || null};\n    continue;\n  }\n  if (Array.isArray(item)) {\n    for (const commit of item) {\n      normalized.push({sha: commit.sha, repo: commit.html_url?.includes('paperclip-platform') ? 'paperclip' : 'openclaw', message: commit.commit?.message || '', author: commit.commit?.author?.name || null, date: commit.commit?.author?.date || null, url: commit.html_url || null});\n    }\n    continue;\n  }\n  if (item && item.sha) {\n    normalized.push({sha: item.sha, repo: item.html_url?.includes('paperclip-platform') ? 'paperclip' : 'openclaw', message: item.commit?.message || '', author: item.commit?.author?.name || null, date: item.commit?.author?.date || null, url: item.html_url || null});\n  }\n}\nconst deduped = []; const seen = new Set();\nfor (const c of normalized) { if (!c.sha || seen.has(c.sha)) continue; seen.add(c.sha); deduped.push(c); }\nreturn [{json:{running_version:'v2026.3.9', latest_release: latestRelease, commit_count: deduped.length, commits: deduped.slice(0,20)}}];"
