    "name": "W27 - Git Backup",
    "description": null,
    "active": true,
    "isArchived": false,
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "cronExpression",
                            "expression": "30 3 * * *"
                        }
                    ]
                }
            },
            "name": "Daily 3:30 AM UTC",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                200,
                300
            ],
            "id": "2d668d33-df1b-459c-a8bc-4ec138465ddb"
        },
        {
            "parameters": {
                "url": "https://n8n-production-7528.up.railway.app/api/v1/workflows",
                "method": "GET",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "X-N8N-API-KEY",
                            "value": "***REDACTED***"
                        }
                    ]
                }
            },
            "name": "Export All Workflows",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                420,
                300
            ],
            "id": "b8ce4882-215a-43d7-89de-c88474dda3c2"
        },
        {
            "parameters": {
                "jsCode": "const workflows = $('Export All Workflows').first().json;\nconst data = workflows.data || [];\n\nconst summary = {\n  workflow_count: data.length,\n  active_count: data.filter(w => w.active).length,\n  workflows: data.map(w => ({\n    id: w.id,\n    name: w.name,\n    active: w.active,\n    updatedAt: w.updatedAt\n  })),\n  backup_timestamp: new Date().toISOString()\n};\n\nreturn [{json: summary}];"
            },
            "name": "Create Backup Summary",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                640,
                300
            ],
            "id": "7ecfb902-ee7f-4285-b0f9-b37308a1a368"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/telemetry",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "={\"service\": \"backup\", \"event_type\": \"workflow_snapshot\", \"payload\": {\"workflow_count\": {{ $json.workflow_count }}, \"active_count\": {{ $json.active_count }}, \"workflows\": {{ JSON.stringify($json.workflows) }}, \"backup_timestamp\": \"{{ $json.backup_timestamp }}\"}}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "***REDACTED***"
                        }
                    ]
                }
            },
            "name": "Log Backup",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                860,
                300
            ],
            "id": "6cdd88f5-8e64-48cc-a5e3-c0b0fea1da51"
        },
        {
            "parameters": {},
            "name": "Error Trigger",
            "type": "n8n-nodes-base.errorTrigger",
            "typeVersion": 1,
            "position": [
                200,
                600
            ],
            "id": "883c0647-1ef3-42c0-9876-adf52826821e"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/telemetry",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "{\"service\": \"n8n\", \"event_type\": \"workflow_error\", \"payload\": {\"workflow\": \"W27 - Git Backup\", \"error\": \"={{ $json.execution.error.message }}\", \"node\": \"={{ $json.execution.lastNodeExecuted }}\", \"timestamp\": \"={{ $now.toISO() }}\", \"execution_id\": \"={{ $json.execution.id }}\"}}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "***REDACTED***"
                        }
                    ]
                }
            },
            "name": "POST Error to Telemetry",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                420,
                600
            ],
            "id": "c5ae8b09-7055-48e2-a4d7-efd2642e66b1"
        },
        {
            "parameters": {
                "jsCode": "const items = $input.all();\nconst outputItems = items.map(i => {\n  const j = {...i.json};\n  // Redact anything that looks like a secret\n  for (const k of Object.keys(j)) {\n    if (/token|key|secret|password|auth|bearer/i.test(k)) j[k] = '[REDACTED]';\n  }\n  return j;\n});\n\nreturn [{ json: {\n  workflow_name: $workflow.name,\n  execution_id: String($execution.id),\n  status: 'completed',\n  items_count: items.length,\n  finished_at: new Date().toISOString(),\n  service_identity: 'n8n-workflows',\n  output_items: outputItems.slice(0, 10),\n  metadata: { node_count: $workflow.nodes?.length || 0 }\n}}];"
            },
            "name": "Prepare Evidence",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1110,
                400
            ],
            "onError": "continueRegularOutput",
            "id": "269f15fd-f3d9-449a-bce0-0dccdac09934"
        },
        {
            "parameters": {
                "url": "http://guardspine-internal.railway.internal:8000/api/v1/ops/evidence/seal",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify($json) }}",
                "options": {
                    "timeout": 10000
                }
            },
            "name": "Seal via GuardSpine",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "onError": "continueRegularOutput",
            "position": [
                1360,
                350
            ],
            "id": "a006a8c9-13ca-40b5-96b6-4436760088cf"
        }
    ],
