    "name": "W10 - Agent Performance Tracker",
    "description": null,
    "active": true,
    "isArchived": false,
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "cronExpression",
                            "expression": "0 8 * * 1"
                        }
                    ]
                }
            },
            "name": "Monday 8 AM",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                200,
                300
            ],
            "id": "f9f4b0f3-0472-43d2-a3a5-f8584964fb50"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/query",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "{\"sql\": \"SELECT a.name, hr.status, COUNT(*) as cnt FROM heartbeat_runs hr JOIN agents a ON hr.agent_id = a.id WHERE hr.started_at > NOW() - INTERVAL '7 days' GROUP BY a.name, hr.status ORDER BY a.name, hr.status\", \"limit\": 100}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "***REDACTED***"
                        }
                    ]
                }
            },
            "name": "Query Heartbeat Stats",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                420,
                250
            ],
            "id": "4bfe1f77-5a36-4d0b-9f3c-ab4d71674440"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/query",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "{\"sql\": \"SELECT solver_used, COUNT(*) as decisions, SUM(CASE WHEN human_override THEN 1 ELSE 0 END) as overrides, ROUND(SUM(CASE WHEN human_override THEN 1 ELSE 0 END)::numeric / NULLIF(COUNT(*), 0), 3) as override_rate FROM decision_journal WHERE ts > NOW() - INTERVAL '7 days' GROUP BY solver_used\", \"limit\": 100}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "***REDACTED***"
                        }
                    ]
                }
            },
            "name": "Query Decision Overrides",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                420,
                400
            ],
            "id": "5c64a187-1211-4577-93f1-cab1a0fa5379"
        },
        {
            "parameters": {
                "jsCode": "const heartbeats = $('Query Heartbeat Stats').all().map(i => i.json);\nconst decisions = $('Query Decision Overrides').all().map(i => i.json);\n\nconst report = ['# Weekly Agent Performance', ''];\n\n// Heartbeat summary per agent\nconst agentStats = {};\nfor (const hb of heartbeats) {\n  if (!agentStats[hb.name]) agentStats[hb.name] = {succeeded: 0, failed: 0, total: 0};\n  agentStats[hb.name][hb.status] = (agentStats[hb.name][hb.status] || 0) + parseInt(hb.cnt);\n  agentStats[hb.name].total += parseInt(hb.cnt);\n}\n\nreport.push('## Heartbeat Success Rates');\nfor (const [name, stats] of Object.entries(agentStats)) {\n  const rate = stats.total > 0 ? ((stats.succeeded || 0) / stats.total * 100).toFixed(0) : 'N/A';\n  report.push(`- ${name}: ${rate}% (${stats.succeeded || 0}/${stats.total})`);\n}\n\nreport.push('', '## Override Rates');\nfor (const d of decisions) {\n  report.push(`- ${d.solver_used}: ${(d.override_rate * 100).toFixed(1)}% (${d.overrides}/${d.decisions})`);\n}\n\nreturn [{json: {report: report.join('\\n')}}];"
            },
            "name": "Format Performance Report",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                640,
                300
            ],
            "id": "d0c854f2-65b7-46f7-8f41-22a9c7ad5b95"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/telemetry",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "{\"service\": \"model_lab\", \"event_type\": \"performance_report\", \"payload\": {\"report\": \"={{ $json.report }}\"}}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "***REDACTED***"
                        }
                    ]
                }
            },
            "name": "Log Performance Report",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                860,
                300
            ],
            "id": "1a570897-7618-4d32-a907-498a9a2a993e"
        },
        {
            "parameters": {},
            "name": "Error Trigger",
            "type": "n8n-nodes-base.errorTrigger",
            "typeVersion": 1,
            "position": [
                200,
