        {
            "parameters": {
                "jsCode": "const notes = $('Fetch Agent Notes').first().json;\nconst telemetry = $('Fetch All Telemetry').first().json;\n\nconst noteRows = notes.rows || [];\nconst allRows = telemetry.rows || [];\n\n// Aggregate PMC moves from agent notes\nconst moveStats = {\n  retrieve: {total: 0, deterministic: 0, intelligence: 0},\n  compare: {total: 0, deterministic: 0, intelligence: 0},\n  classify: {total: 0, deterministic: 0, intelligence: 0},\n  infer: {total: 0, deterministic: 0, intelligence: 0},\n  flag: {total: 0, deterministic: 0, intelligence: 0},\n  prioritize: {total: 0, deterministic: 0, intelligence: 0}\n};\n\nconst agentStats = {};\nlet totalActions = 0;\nlet totalDeterministic = 0;\n\nfor (const row of noteRows) {\n  const payload = typeof row.payload === 'string' ? JSON.parse(row.payload) : (row.payload || {});\n  const agent = payload.agent || 'unknown';\n\n  if (!agentStats[agent]) {\n    agentStats[agent] = {heartbeats: 0, actions: 0, deterministic: 0, intelligence: 0, moves: {}};\n  }\n  agentStats[agent].heartbeats++;\n\n  for (const action of (payload.actions || [])) {\n    const move = action.move || 'unknown';\n    const isDet = action.deterministic === true;\n\n    totalActions++;\n    if (isDet) totalDeterministic++;\n\n    if (moveStats[move]) {\n      moveStats[move].total++;\n      if (isDet) moveStats[move].deterministic++;\n      else moveStats[move].intelligence++;\n    }\n\n    agentStats[agent].actions++;\n    if (isDet) agentStats[agent].deterministic++;\n    else agentStats[agent].intelligence++;\n\n    if (!agentStats[agent].moves[move]) agentStats[agent].moves[move] = 0;\n    agentStats[agent].moves[move]++;\n  }\n}\n\n// Analyze telemetry for workflow vs agent activity ratio\nconst workflowEvents = allRows.filter(r => r.service === 'n8n' || (r.event_type || '').includes('workflow'));\nconst agentEvents = allRows.filter(r => r.service === 'agent_notes' || (r.service || '').includes('cmo') || (r.service || '').includes('cto'));\n\n// Generate optimization recommendations\nconst recommendations = [];\n\n// Check if any agent has >50% deterministic actions\nfor (const [agent, stats] of Object.entries(agentStats)) {\n  if (stats.actions > 5 && stats.deterministic / stats.actions > 0.5) {\n    recommendations.push({\n      type: 'migrate_to_n8n',\n      agent: agent,\n      reason: Math.round(100 * stats.deterministic / stats.actions) + '% of actions are deterministic',\n      top_deterministic_moves: Object.entries(stats.moves)\n        .sort((a, b) => b[1] - a[1])\n        .slice(0, 3)\n        .map(([m, c]) => m + ' (' + c + 'x)')\n    });\n  }\n}\n\n// Check if retrieve is the dominant move (common pattern to migrate)\nif (moveStats.retrieve.deterministic > moveStats.retrieve.intelligence * 2) {\n  recommendations.push({\n    type: 'retrieve_migration',\n    reason: 'Most retrieve actions are deterministic -- consider moving data fetching to n8n HTTP nodes'\n  });\n}\n\n// Check if classify is highly deterministic (rule-based classification should be n8n)\nif (moveStats.classify.deterministic > moveStats.classify.intelligence) {\n  recommendations.push({\n    type: 'classify_migration',\n    reason: 'Most classify actions are deterministic -- consider moving to n8n Code nodes with rule tables'\n  });\n}\n\nconst report = {\n  week_summary: {\n    total_heartbeats: noteRows.length,\n    total_actions: totalActions,\n    deterministic_pct: totalActions > 0 ? Math.round(100 * totalDeterministic / totalActions) : 0,\n    intelligence_pct: totalActions > 0 ? Math.round(100 * (totalActions - totalDeterministic) / totalActions) : 0,\n    current_split: totalActions > 0 ?\n      Math.round(100 * totalDeterministic / totalActions) + '/' + Math.round(100 * (totalActions - totalDeterministic) / totalActions) + ' (det/intel)' :\n      'no data'\n  },\n  move_breakdown: moveStats,\n  agent_breakdown: agentStats,\n  workflow_vs_agent: {\n    workflow_events: workflowEvents.length,\n    agent_events: agentEvents.length,\n    total_telemetry: allRows.length\n  },\n  recommendations: recommendations,\n  analyzed_at: new Date().toISOString()\n};\n\nreturn [{json: report}];"
            },
