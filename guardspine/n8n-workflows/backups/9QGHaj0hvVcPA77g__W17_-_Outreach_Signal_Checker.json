    "name": "W17 - Outreach Signal Checker",
    "description": null,
    "active": true,
    "isArchived": false,
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "cronExpression",
                            "expression": "30 4 * * *"
                        }
                    ]
                }
            },
            "name": "Daily 4:30 AM UTC",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                200,
                300
            ],
            "id": "24cc0446-5172-44db-b180-8195a5387d67"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/query",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "{\"query_name\": \"recent_telemetry\", \"params\": {\"limit\": 50}}"
            },
            "name": "Fetch Recent Telemetry",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                420,
                300
            ],
            "id": "39b396c5-3ecd-4d69-899f-dac3f2925c38"
        },
        {
            "parameters": {
                "jsCode": "const items = $('Fetch Recent Telemetry').all().map(i => i.json);\n\nconst signalDetails = [];\n\nfor (const evt of items) {\n  const svc = (evt.service || '').toLowerCase();\n  const evtType = (evt.event_type || '').toLowerCase();\n\n  if (svc.includes('outreach') || svc.includes('cmo') || evtType.includes('outreach') || evtType.includes('lead') || evtType.includes('signal')) {\n    signalDetails.push({\n      service: evt.service || 'unknown',\n      event_type: evt.event_type || 'unknown',\n      created_at: evt.created_at || evt.timestamp || 'unknown',\n      payload_preview: typeof evt.payload === 'string' ? evt.payload.substring(0, 200) : JSON.stringify(evt.payload || {}).substring(0, 200)\n    });\n  }\n}\n\nreturn [{\n  json: {\n    new_signals: signalDetails.length,\n    signal_details: signalDetails,\n    events_scanned: items.length,\n    checked_at: new Date().toISOString()\n  }\n}];"
            },
            "name": "Analyze Outreach Signals",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                640,
                300
            ],
            "id": "3eac15a4-3586-4216-b18f-62b515dcabbd"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/telemetry",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "={\"service\": \"outreach-monitor\", \"event_type\": \"signal_check\", \"payload\": {\"new_signals\": {{ $json.new_signals }}, \"signal_details\": {{ JSON.stringify($json.signal_details) }}, \"events_scanned\": {{ $json.events_scanned }}, \"checked_at\": \"{{ $json.checked_at }}\"}}"
            },
            "name": "Log Signal Check",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                860,
                300
            ],
            "id": "1b9d0370-226e-4ecd-9499-fbebe730675e"
        },
        {
            "parameters": {},
            "name": "Error Trigger",
            "type": "n8n-nodes-base.errorTrigger",
            "typeVersion": 1,
            "position": [
                200,
                600
            ],
            "id": "9fd35987-8b0e-47a5-a869-f44a9f320054"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/telemetry",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "{\"service\": \"n8n\", \"event_type\": \"workflow_error\", \"payload\": {\"workflow\": \"W17 - Outreach Signal Checker\", \"error\": \"={{ $json.execution.error.message }}\", \"node\": \"={{ $json.execution.lastNodeExecuted }}\", \"timestamp\": \"={{ $now.toISO() }}\", \"execution_id\": \"={{ $json.execution.id }}\"}}"
            },
            "name": "POST Error to Telemetry",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                420,
                600
            ],
            "id": "9609dc35-28be-4a8f-8ed9-d26c111ab54c"
        },
        {
            "parameters": {
                "jsCode": "const items = $input.all();\nconst outputItems = items.map(i => {\n  const j = {...i.json};\n  // Redact anything that looks like a secret\n  for (const k of Object.keys(j)) {\n    if (/token|key|secret|password|auth|bearer/i.test(k)) j[k] = '[REDACTED]';\n  }\n  return j;\n});\n\nreturn [{ json: {\n  workflow_name: $workflow.name,\n  execution_id: String($execution.id),\n  status: 'completed',\n  items_count: items.length,\n  finished_at: new Date().toISOString(),\n  service_identity: 'n8n-workflows',\n  output_items: outputItems.slice(0, 10),\n  metadata: { node_count: $workflow.nodes?.length || 0 }\n}}];"
            },
            "name": "Prepare Evidence",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1110,
                400
            ],
            "onError": "continueRegularOutput",
            "id": "59838dd8-ad77-4afe-a773-b2e76b554e38"
        },
        {
            "parameters": {
                "url": "http://guardspine-internal.railway.internal:8000/api/v1/ops/evidence/seal",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify($json) }}",
                "options": {
                    "timeout": 10000
                }
            },
            "name": "Seal via GuardSpine",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "onError": "continueRegularOutput",
            "position": [
                1360,
                350
            ],
            "id": "f4fa4627-0170-475e-8eb6-316f23147d33"
        }
    ],
