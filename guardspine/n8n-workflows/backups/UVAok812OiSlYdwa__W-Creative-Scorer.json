    "id": "UVAok812OiSlYdwa",
    "name": "W-Creative-Scorer",
    "description": null,
    "active": true,
    "isArchived": false,
    "nodes": [
        {
            "name": "Weekly Cron",
            "type": "n8n-nodes-base.scheduleTrigger",
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "triggerAtDay": 1,
                            "triggerAtHour": 11
                        }
                    ]
                }
            },
            "id": "988cf8f9-20ec-48ca-97c5-5d3f1dec31a8"
        },
        {
            "name": "Webhook Trigger",
            "type": "n8n-nodes-base.webhook",
            "parameters": {
                "path": "creative-scorer",
                "httpMethod": "POST",
                "responseMode": "lastNode",
                "options": {}
            },
            "id": "15a8807d-bdc9-471b-b2c4-a9f2a5eaf49c"
        },
        {
            "name": "Build Criteria Spec",
            "type": "n8n-nodes-base.code",
            "parameters": {
                "jsCode": "\nconst criteria=['Hook strength','Pain specificity','Evidence density','Platform fit','Swap test','CTA clarity','Word count','Banned word check','Social proof','Timing alignment'];\nreturn [{json:{criteria,threshold:7.0,context:{target:'CISOs, DevOps leads, compliance officers, developers',channels:['Reddit','dev.to','email','LinkedIn'],pain_buckets:['review_velocity_gap','compliance_gap','ai_governance_gap','regulatory_pressure'],historical:'warm intros 40% response, cold LinkedIn 10%, cold email 0.67%',word_range:'80-140',best_days:['Tue','Wed'],rule:'Enter through PAIN not vision.'},timestamp:new Date().toISOString()}}];\n"
            },
            "id": "a586dda5-7810-4386-842e-452144760f66"
        },
        {
            "name": "Generate Rubric Weights",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "method": "POST",
                "url": "http://litellm.railway.internal:4000/v1/chat/completions",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "httpHeaderAuth",
                "sendBody": true,
                "specifyBody": "string",
                "body": "={{ JSON.stringify({\"model\":\"openrouter/anthropic/claude-sonnet-4\",\"messages\":[{\"role\":\"system\",\"content\":\"Return ONLY JSON with keys rubric_version, criteria. For the provided fixed list of 10 criteria, assign weight 1-3, example_high, example_low. Do not add or remove criteria.\"},{\"role\":\"user\",\"content\": JSON.stringify($json)}],\"max_tokens\":2200,\"temperature\":0.2}) }}",
                "contentType": "application/json",
                "options": {}
            },
            "id": "2312b89e-23ac-4dd2-bc5f-26958b99b633"
        },
        {
            "name": "Validate Rubric",
            "type": "n8n-nodes-base.code",
            "parameters": {
                "jsCode": "\nconst content=$json.choices?.[0]?.message?.content || '{}';\nlet rubric={}, errors=[]; try { const m=content.match(/\\{[\\s\\S]*\\}/); rubric=JSON.parse(m?m[0]:content);} catch(e){ errors.push('parse_error'); rubric={}; }\nconst expected=['Hook strength','Pain specificity','Evidence density','Platform fit','Swap test','CTA clarity','Word count','Banned word check','Social proof','Timing alignment'];\nconst criteria=Array.isArray(rubric.criteria)?rubric.criteria:[];\nif(criteria.length!==10) errors.push('criteria_count');\nconst names=criteria.map(c=>c.name);\nfor (const name of expected) if(!names.includes(name)) errors.push('missing_'+name.replace(/\\W+/g,'_').toLowerCase());\nif(criteria.some(c=>Number(c.weight)<1 || Number(c.weight)>3)) errors.push('weight_bounds');\nif(criteria.some(c=>!c.example_high || !c.example_low)) errors.push('examples_missing');\nconst normalized=criteria.map(c=>({name:c.name,weight:Number(c.weight),example_high:String(c.example_high||'').slice(0,220),example_low:String(c.example_low||'').slice(0,220)}));\nreturn [{json:{rubric:{rubric_version:rubric.rubric_version||1,criteria:normalized,overall_threshold:$('Build Criteria Spec').first().json.threshold},generated_at:new Date().toISOString(),status:errors.length?'error':'success',validation_errors:errors}}];\n"
            },
            "id": "1a16c7d0-c886-43c1-b866-cc33c7cc2ad5"
        },
        {
            "name": "Rubric OK?",
            "type": "n8n-nodes-base.if",
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "strict"
                    },
                    "conditions": [
                        {
                            "id": "ok",
                            "leftValue": "={{ $json.status }}",
                            "rightValue": "success",
                            "operator": {
                                "type": "string",
                                "operation": "equals"
                            }
                        }
                    ],
                    "combinator": "and"
                }
            },
            "id": "77dff61c-a52f-4439-b5d6-6157a95653d1"
        },
        {
            "name": "Post to Pipeline",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "method": "POST",
                "url": "https://slack.com/api/chat.postMessage",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "slackApi",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\"channel\":\"C0AKXAYJ41W\",\"text\":\"\ud83d\udccf *Scoring Rubric v\"+($json.rubric.rubric_version||1)+\"*\\nCriteria: \"+($json.rubric.criteria?.length||\"?\")+\"\\nThreshold: \"+($json.rubric.overall_threshold||7)+\"/10\\nStatus: \"+$json.status}",
                "options": {}
            },
            "id": "312e67eb-96df-47fd-952b-306591fdbe18"
        },
        {
            "name": "Post Validation Failure",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "method": "POST",
                "url": "https://slack.com/api/chat.postMessage",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "slackApi",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\"channel\":\"C0AKXAYJ41W\",\"text\":\"\u26a0\ufe0f Creative scorer rubric blocked. Validation: \"+(($json.validation_errors||[]).join(\", \")||\"unknown\")}",
                "options": {}
            },
            "id": "572d539d-ccf8-4ec5-81d0-7bec8d70a505"
        },
        {
            "name": "Seal",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "method": "POST",
                "url": "http://guardspine-internal.railway.internal:8000/api/v1/ops/evidence/seal",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "httpHeaderAuth",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\"stream\":\"creative_scoring\",\"event_type\":\"rubric_generated\",\"payload\":{\"status\":$json.status,\"validation_errors\":$json.validation_errors||[]},\"source\":\"W-Creative-Scorer\"}",
                "options": {}
            },
            "id": "1da19549-285c-4517-8bcc-0128ba677825"
        }
    ],
