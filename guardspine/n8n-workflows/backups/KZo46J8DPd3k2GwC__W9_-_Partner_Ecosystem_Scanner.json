            "name": "Mon+Thu 10 AM",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                200,
                300
            ],
            "id": "1d7916ea-a913-4f41-bb2a-6bc5ce4f43fb"
        },
        {
            "parameters": {
                "url": "https://hn.algolia.com/api/v1/search_by_date?query=SBOM+OR+%22code+governance%22+OR+%22code+review+automation%22+OR+AppSec&tags=story&numericFilters=created_at_i>={{ Math.floor(Date.now()/1000) - 604800 }}"
            },
            "name": "Scan HackerNews",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                420,
                250
            ],
            "id": "17c3bd6b-b587-47d1-b587-2e7296b00938"
        },
        {
            "parameters": {
                "url": "https://www.reddit.com/r/devops+netsec+devsecops/search.json?q=code+governance+OR+SBOM+OR+evidence+bundle&sort=new&t=week&limit=20"
            },
            "name": "Scan Reddit",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                420,
                400
            ],
            "id": "26b21b0b-a571-4538-bc06-2819bb48f265"
        },
        {
            "parameters": {
                "jsCode": "const hn = $('Scan HackerNews').first().json.hits || [];\nconst reddit = ($('Scan Reddit').first().json?.data?.children || []).map(c => c.data);\n\nconst items = [];\nfor (const h of hn.slice(0, 10)) {\n  items.push({source: 'hackernews', title: h.title || '', url: h.url || `https://news.ycombinator.com/item?id=${h.objectID}`, points: h.points || 0, comments: h.num_comments || 0});\n}\nfor (const r of reddit.slice(0, 10)) {\n  items.push({source: 'reddit', title: r.title || '', url: `https://reddit.com${r.permalink}`, points: r.score || 0, comments: r.num_comments || 0, subreddit: r.subreddit || ''});\n}\n\n// Score by relevance\nconst keywords = ['sbom', 'governance', 'evidence', 'audit', 'compliance', 'appsec', 'ci/cd', 'github action'];\nfor (const item of items) {\n  const titleLow = item.title.toLowerCase();\n  item.relevance = keywords.filter(k => titleLow.includes(k)).length;\n}\n\nitems.sort((a, b) => b.relevance - a.relevance || b.points - a.points);\nreturn items.slice(0, 5).map(i => ({json: i}));"
            },
            "name": "Score & Rank",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                640,
                300
            ],
            "id": "b14731a8-2517-4ef8-b290-72ed0a8b3acc"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/telemetry",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "{\"service\": \"bizdev\", \"event_type\": \"partner_scan\", \"payload\": {\"source\": \"={{ $json.source }}\", \"title\": \"={{ $json.title }}\", \"url\": \"={{ $json.url }}\", \"relevance\": \"={{ $json.relevance }}\", \"points\": \"={{ $json.points }}\"}}"
            },
            "name": "Log Scan Results",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                860,
                300
            ],
            "id": "3ff188a7-048d-4923-b151-95718aed2e57"
        },
        {
            "parameters": {},
