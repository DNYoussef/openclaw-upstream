        {
            "name": "Analyze Heartbeat",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                730,
                300
            ],
            "id": "analyze-73501bb1",
            "parameters": {
                "jsCode": "const scan = $(\"Scan Communities\").first().json || {};\nconst rawIssues = $json;\nconst issues = Array.isArray(rawIssues) ? rawIssues : (Array.isArray(rawIssues.items) ? rawIssues.items : (Array.isArray(rawIssues.data) ? rawIssues.data : []));\nconst title = '[Heartbeat] Community scanning and signal detection';\nconst openMatch = issues.filter(i => ['todo','backlog','in_progress'].includes(i.status) && i.title === title);\nconst threadsFound = Number(scan.threads_found || (Array.isArray(scan.threads) ? scan.threads.length : 0) || 0);\nconst prospectsAdded = Number(scan.prospects_added || 0);\nconst signalScore = (threadsFound * 2) + (prospectsAdded * 4);\nconst priority = signalScore >= 8 ? 'urgent' : signalScore >= 3 ? 'high' : 'medium';\nconst shouldCreate = openMatch.length === 0 && (threadsFound > 0 || prospectsAdded > 0);\nconst summary = { threadsFound, prospectsAdded, signalScore, scanStatus: scan.status || 'ok', topThreads: (scan.threads || []).slice(0,3).map(t => ({ title: t.title || t.thread_title || 'untitled', url: t.url || t.link || null })) };\nconst description = [\n  'Automated narrowcast heartbeat summary.',\n  '',\n  'Threads found: ' + threadsFound,\n  'Prospects added: ' + prospectsAdded,\n  'Signal score: ' + signalScore,\n  'Priority rationale: ' + priority,\n  '',\n  'Top threads:',\n  ...summary.topThreads.map((t, i) => (i + 1) + '. ' + t.title + (t.url ? ' - ' + t.url : '')), \n].join('\\n');\nreturn [{ json: { shouldCreate, priority, dedupReason: openMatch.length ? 'existing_open_heartbeat' : (threadsFound === 0 && prospectsAdded === 0 ? 'no_new_signals' : null), summary, taskPayload: { title, description, status: 'todo', priority } } }];"
            }
        },
        {
            "name": "Should Create Task?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2.2,
            "position": [
                980,
                300
            ],
            "id": "should-create-7098670c",
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": ""
                    },
                    "conditions": [
                        {
                            "id": "should-create",
                            "leftValue": "={{ $json.shouldCreate }}",
                            "rightValue": true,
                            "operator": {
                                "type": "boolean",
                                "operation": "true",
                                "singleValue": true
                            }
                        }
                    ]
                }
            }
        },
