        {
            "name": "Check Evidence Bundles",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                500,
                660
            ],
            "parameters": {
                "method": "POST",
                "url": "http://localhost:5678/webhook/pilot-pipeline",
                "sendBody": true,
                "contentType": "json",
                "body": "{\"action\":\"check_evidence_bundles\"}",
                "options": {}
            },
            "id": "1d633c74-0712-4e6c-bbfa-f3ab919fd505"
        },
        {
            "name": "Normalize Evidence Events",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                750,
                400
            ],
            "parameters": {
                "jsCode": "const timestamp = new Date().toISOString();\nconst items = $input.all();\nconst normalizedEvents = [];\n\nfor (const item of items) {\n  const data = item.json;\n  let source = 'unknown';\n  let sourceReliability = 0.5;\n  let fitsAffected = [];\n  let metricOrClaim = 'signal';\n  let direction = 'neutral';\n  let magnitude = 0.5;\n  let confidence = 0.5;\n  let linkedEntity = null;\n  let quoteOrPayload = JSON.stringify(data);\n  let recommendedInterpretation = 'Requires interpretation';\n\n  if (data.lane !== undefined || data.total_contacts !== undefined) {\n    source = 'outreach_pipeline';\n    sourceReliability = 0.9;\n    fitsAffected = ['MP', 'PC'];\n    metricOrClaim = 'pipeline_activity';\n    direction = (data.total_contacts > 0) ? 'positive' : 'neutral';\n    magnitude = Math.min((data.total_contacts || 0) / 100, 1.0);\n    confidence = 0.85;\n    recommendedInterpretation = 'Pipeline activity from outreach';\n  } else if (data.signals !== undefined) {\n    source = 'response_signals';\n    sourceReliability = 0.85;\n    fitsAffected = ['MP', 'PC', 'CM'];\n    metricOrClaim = 'response_rate';\n    const sigs = data.signals || [];\n    direction = sigs.length > 0 ? 'positive' : 'neutral';\n    magnitude = Math.min(sigs.length / 10, 1.0);\n    confidence = 0.8;\n    recommendedInterpretation = sigs.length + ' response signals detected';\n  } else if (data.scan_results !== undefined) {\n    source = 'narrowcast_communities';\n    sourceReliability = 0.75;\n    fitsAffected = ['MP', 'MM'];\n    metricOrClaim = 'community_engagement';\n    const results = data.scan_results || [];\n    direction = results.length > 0 ? 'positive' : 'neutral';\n    magnitude = Math.min(results.length / 20, 1.0);\n    confidence = 0.7;\n    recommendedInterpretation = 'Community scan: ' + results.length + ' threads';\n  } else if (data.evidence_bundles !== undefined) {\n    source = 'pilot_evidence';\n    sourceReliability = 0.9;\n    fitsAffected = ['PC', 'CM'];\n    metricOrClaim = 'pilot_evidence';\n    const bundles = data.evidence_bundles || [];\n    direction = bundles.length > 0 ? 'positive' : 'neutral';\n    magnitude = Math.min(bundles.length / 5, 1.0);\n    confidence = 0.85;\n    recommendedInterpretation = bundles.length + ' pilot evidence bundles';\n  }\n\n  normalizedEvents.push({\n    json: {\n      timestamp,\n      source,\n      source_reliability: sourceReliability,\n      fits_affected: fitsAffected,\n      metric_or_claim: metricOrClaim,\n      direction,\n      magnitude,\n      confidence,\n      linked_entity: linkedEntity,\n      quote_or_payload: quoteOrPayload,\n      recommended_interpretation: recommendedInterpretation\n    }\n  });\n}\n\nif (normalizedEvents.length === 0) {\n  return [{ json: { timestamp, source: 'weekly_observe', source_reliability: 0.9, fits_affected: ['MP','PC','CM','MM'], metric_or_claim: 'weekly_run_completed', direction: 'neutral', magnitude: 0, confidence: 1.0, linked_entity: null, quote_or_payload: null, recommended_interpretation: 'Weekly observation: no new signals' } }];\n}\n\nreturn normalizedEvents;"
            },
            "id": "89957001-9c97-494d-8ef8-68717e0f77ba"
        },
        {
            "name": "Output Evidence Items",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1000,
                400
            ],
            "parameters": {
                "jsCode": "const events = $input.all();\nconsole.log('Four-Fit Weekly Observe: ' + events.length + ' evidence events');\nreturn events.map(e => ({ json: e.json }));"
            },
            "id": "e9d09e98-37da-40f5-a9bb-4ef6a5c49f1e"
        },
