        {
            "name": "Build Summary",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1750,
                300
            ],
            "parameters": {
                "jsCode": "const now = new Date().toISOString(); const date = now.split('T')[0]; const summary = { date, timestamp: now, status: 'completed', sources: {}, regulatory_pressure: 0, market_sentiment: 0, legislative_activity: 0, recommended_mode: 'balanced' }; const items = $input.all(); for (const item of items) { const d = item.json; if (d.data && d.data.last_week !== undefined) { summary.sources.pypi = { langchain_weekly: d.data.last_week }; } if (d.stargazers_count !== undefined) { summary.sources.github = { stars: d.stargazers_count, forks: d.forks_count }; } if (d.nbHits !== undefined) { summary.sources.hackernews = { mentions: d.nbHits }; summary.market_sentiment += d.nbHits; } if (d.count !== undefined && d.results) { summary.sources.federal_register = { proposed_rules: d.count }; summary.regulatory_pressure += d.count; } if (d.bills) { summary.sources.congress = { active_bills: d.bills.length }; summary.legislative_activity += d.bills.length; } } if (summary.regulatory_pressure > 15) summary.recommended_mode = 'defensive'; else if (summary.market_sentiment > 30) summary.recommended_mode = 'growth'; return [{ json: summary }];"
            },
            "id": "182bb30d-e359-4845-89cf-b73f29367f25"
        },
