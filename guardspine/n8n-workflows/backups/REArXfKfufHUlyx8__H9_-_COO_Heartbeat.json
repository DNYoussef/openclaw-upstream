        {
            "name": "Analyze Heartbeat",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                780,
                300
            ],
            "id": "analyze-fc8755e4",
            "parameters": {
                "jsCode": "const issuesRaw = $('Fetch Open Issues').first().json; const issues = Array.isArray(issuesRaw)?issuesRaw:(issuesRaw.items||issuesRaw.data||[]); const errRaw = $('Fetch n8n Errors').first().json; const errs = Array.isArray(errRaw.data)?errRaw.data:(Array.isArray(errRaw)?errRaw:[]); const tele = $('Fetch Recent Telemetry').first().json.rows || [];\nconst title='[Heartbeat] Operations health and workflow efficiency'; const openMatch = issues.filter(i => ['todo','backlog','in_progress'].includes(i.status) && i.title===title);\nconst workflowErrors = errs.length; const metaRuns = tele.filter(e => String(e.event_type||'')==='meta_cron').length; const recentFailures = tele.filter(e => String(e.event_type||'')==='workflow_error').length;\nconst priority = workflowErrors > 10 || recentFailures > 10 ? 'high' : workflowErrors > 0 ? 'medium' : 'low';\nconst summary = { failedExecutions: workflowErrors, workflowErrorEvents: recentFailures, successfulCronSignals: metaRuns };\nconst description = ['Automated COO heartbeat summary.','', 'Failed n8n executions (recent): ' + workflowErrors, 'Workflow error telemetry events: ' + recentFailures, 'Cron/meta workflow signals seen: ' + metaRuns, 'Priority rationale: ' + priority].join('\n');\nreturn [{json:{ shouldCreate: openMatch.length===0, priority, dedupReason: openMatch.length ? 'existing_open_heartbeat' : null, summary, taskPayload:{ title, description, status:'todo', priority } }}];"
            }
        },
        {
            "name": "Should Create Task?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2.2,
            "position": [
                1030,
                300
            ],
            "id": "should-d9c7c845",
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": ""
                    },
                    "conditions": [
                        {
                            "id": "go",
                            "leftValue": "={{ $json.shouldCreate }}",
                            "rightValue": true,
                            "operator": {
                                "type": "boolean",
                                "operation": "true",
                                "singleValue": true
                            }
                        }
                    ]
                }
            }
        },
