        {
            "parameters": {
                "jsCode": "const data = $input.first().json.data || [];\nconst cutoff = new Date(Date.now() - 12*60*60*1000);\nconst recent = data.filter(e => e.startedAt && new Date(e.startedAt) > cutoff);\nconst ok = recent.filter(e => e.status === 'success').length;\nconst err = recent.filter(e => e.status === 'error').length;\nconst wf = {}, we = {};\nrecent.forEach(e => { const n = (e.workflowData||{}).name || e.workflowId || '?'; wf[n]=(wf[n]||0)+1; if(e.status==='error') we[n]=(we[n]||0)+1; });\nconst day = new Date().toLocaleDateString('en-US',{weekday:'long',year:'numeric',month:'long',day:'numeric',timeZone:'America/New_York'});\nlet t = ':sunny: *MORNING BRIEF - ' + day + '*\\n\\n';\nt += '*OVERNIGHT STATUS*\\n';\nt += '- ' + recent.length + ' executions (12h) | :white_check_mark: ' + ok + ' ok | :x: ' + err + ' failed\\n\\n';\nconst top = Object.entries(wf).sort((a,b)=>b[1]-a[1]).slice(0,10);\nif(top.length){ t += '*Top workflows:*\\n'; top.forEach(([n,c])=>{ const e=we[n]||0; t+='- '+(e>0?':x:':':white_check_mark:')+' '+c+'x '+n+(e>0?' ('+e+' err)':'')+\"\\n\"; }); }\nconst errs = Object.entries(we).sort((a,b)=>b[1]-a[1]);\nif(errs.length){ t+='\\n*:warning: Failures:*\\n'; errs.slice(0,15).forEach(([n,c])=>t+='- '+n+': '+c+'x\\n'); }\nt += '\\n*:dart: TODAY:*\\n';\nif(err>0) t += '1. Investigate ' + err + ' workflow failures\\n';\nt += (err>0?'2':'1') + '. Check agent heartbeats\\n';\nt += (err>0?'3':'2') + '. Review outreach pipeline\\n';\nreturn [{json:{text:t}}];"
            },
