                "url": "http://guardspine-internal.railway.internal:8000/api/v1/ops/evidence/seal",
                "authentication": "noAuth",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({stream_key: 'draft-followups', execution_id: 'df-' + Date.now(), event_type: 'followup_drafted', payload: {prospect: $json.name, company: $json.company, pain_bucket: $json.pain_bucket, word_count: $json.word_count}, meta: {workflow: 'W-Draft-Followups'}}) }}",
                "options": {}
            },
            "id": "1181bec8-9426-4269-9d40-7a0c01b746c0"
        }
