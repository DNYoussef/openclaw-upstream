                "authentication": "genericCredentialType",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({channel: 'C0AKXAYJ41W', text: '\ud83d\udcdd Followup drafted for ' + $json.name + ' (' + $json.company + ') \u2014 ' + $json.word_count + ' words, pain: ' + $json.pain_bucket}) }}",
                "options": {},
                "genericAuthType": "httpHeaderAuth"
            },
            "id": "01254ec1-a6d7-4239-a198-df703877aa1f",
            "credentials": {
                "httpHeaderAuth": {
                    "id": "To6ERybK9OzH9rtu",
