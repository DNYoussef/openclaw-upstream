        {
            "name": "Get Followups Due",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "method": "POST",
                "url": "http://openclaw.railway.internal:18789/webhook/outreach-pipeline",
                "authentication": "genericCredentialType",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "{\"action\": \"check_followups_due\"}",
                "options": {},
                "genericAuthType": "httpHeaderAuth"
            },
            "id": "62ce0721-4761-4f1b-b375-4aca91b698b4",
            "credentials": {
                "httpHeaderAuth": {
                    "id": "sS3WHLXNPKSkpIC2",
                    "name": "openclaw-gateway-auth"
                }
            }
        },
        {
            "name": "Has Followups?",
            "type": "n8n-nodes-base.if",
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "strict"
                    },
                    "conditions": [
                        {
                            "id": "has-followups",
                            "leftValue": "={{ $json.followups_due_count }}",
                            "rightValue": 0,
                            "operator": {
                                "type": "number",
                                "operation": "gt"
                            }
                        }
                    ],
                    "combinator": "and"
                }
            },
            "id": "bee864f6-5da8-4b54-9f9b-cba23243e367"
        },
        {
            "name": "Prepare Batch",
            "type": "n8n-nodes-base.code",
            "parameters": {
                "jsCode": "\nconst followups = Array.isArray($json.followups_due) ? $json.followups_due : [];\nreturn followups.slice(0,5).map(p => ({json:{prospect_id:p.id,name:p.name,company:p.company,lane:p.lane || 'unknown',channel:p.channel || 'linkedin_dm',last_sent:p.message_sent_at,days_since:Math.max(0, Math.floor((Date.now() - new Date(p.message_sent_at).getTime()) / 86400000)),prior_summary:[p.last_message_subject,p.last_message_body,p.notes].filter(Boolean).join(' | ').slice(0,500)}}));\n"
            },
            "id": "b89b04f1-cb54-4a15-b829-689ced886687"
        },
        {
            "name": "Classify Followup Strategy",
            "type": "n8n-nodes-base.code",
            "parameters": {
                "jsCode": "\nconst j=$json;\nconst stage = j.days_since >= 14 ? 'reengage' : j.days_since >= 7 ? 'nudge' : 'fresh_followup';\nconst lanePain = {builder:'review_velocity_gap',buyer:'compliance_gap',connector:'ai_governance_gap',investor:'regulatory_pressure'};\nreturn [{json:{...j,followup_stage:stage,suggested_pain_bucket:lanePain[j.lane] || 'general',timing_band:j.days_since >= 14 ? '14_plus' : j.days_since >= 7 ? '7_13' : '0_6'}}];\n"
            },
            "id": "862b0033-d4e8-4896-adf3-0c21ff697cc4"
        },
        {
            "name": "Draft via LLM",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "method": "POST",
                "url": "http://litellm.railway.internal:4000/v1/chat/completions",
                "authentication": "genericCredentialType",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({model:\"gpt-4o-mini\",messages:[{role:\"system\",content:\"Return ONLY JSON with keys: draft, pain_bucket, subject_hint, personalization_used (array), banned_words_found (array). Rules: 80-140 words, enter through pain not vision, no corporate filler, be direct and specific.\"},{role:\"user\",content:\"Write a followup for\\nName: \" + $json.name + \"\\nCompany: \" + $json.company + \"\\nLane: \" + $json.lane + \"\\nChannel: \" + $json.channel + \"\\nDays since last contact: \" + $json.days_since + \"\\nFollowup stage: \" + $json.followup_stage + \"\\nSuggested pain bucket: \" + $json.suggested_pain_bucket + \"\\nPrior context: \" + ($json.prior_summary || \"none\") }],max_tokens:400,temperature:0.5}) }}",
                "options": {},
                "genericAuthType": "httpHeaderAuth"
            },
            "id": "708fdd1b-a4f0-4e57-a489-121236f2e213",
            "credentials": {
                "httpHeaderAuth": {
                    "id": "JOEzshTgTJqyjYRg",
                    "name": "litellm-auth"
                }
            }
        },
        {
            "name": "Validate Draft",
            "type": "n8n-nodes-base.code",
            "parameters": {
                "jsCode": "\nconst raw=$json.choices?.[0]?.message?.content || '{}'; const base=$('Classify Followup Strategy').first().json; let parsed={}, errors=[];\ntry { const m=raw.match(/\\{[\\s\\S]*\\}/); parsed=JSON.parse(m?m[0]:raw);} catch(e){ errors.push('parse_error'); parsed={draft:raw,pain_bucket:base.suggested_pain_bucket,banned_words_found:[]}; }\nconst draft=String(parsed.draft || '').trim(); const wc=draft ? draft.split(/\\s+/).length : 0;\nconst banned=['delve','leverage','paradigm','synergy','revolutionize','transform','unlock','supercharge','empower','game-changing','cutting-edge','holistic','robust','seamless','innovative'];\nconst found=banned.filter(w=>draft.toLowerCase().includes(w));\nif(wc < 80 || wc > 140) errors.push('word_count_out_of_bounds');\nif(found.length) errors.push('banned_words');\nconst first=(base.name||'').split(' ')[0].toLowerCase();\nif(base.company && !draft.toLowerCase().includes(base.company.toLowerCase()) && first && !draft.toLowerCase().includes(first)) errors.push('missing_personalization');\nreturn [{json:{prospect_id:base.prospect_id,name:base.name,company:base.company,channel:base.channel,draft,pain_bucket:parsed.pain_bucket || base.suggested_pain_bucket,model_used:$json.model || 'gpt-4o-mini',word_count:wc,followup_stage:base.followup_stage,validation_errors:errors,status:errors.length?'blocked':'ready'}}];\n"
            },
            "id": "9d56b384-eccd-4a82-9e06-fecce7c4a77a"
        },
        {
            "name": "Draft OK?",
            "type": "n8n-nodes-base.if",
            "parameters": {
                "conditions": {
                    "options": {
                        "caseSensitive": true,
                        "leftValue": "",
                        "typeValidation": "strict"
                    },
                    "conditions": [
                        {
                            "id": "ok",
                            "leftValue": "={{ $json.status }}",
                            "rightValue": "ready",
                            "operator": {
                                "type": "string",
                                "operation": "equals"
                            }
                        }
                    ],
                    "combinator": "and"
                }
            },
            "id": "7b166a2c-c258-48ea-b6e6-6d5aa525dd4b"
        },
        {
            "name": "Save to DB",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "method": "POST",
                "url": "http://openclaw.railway.internal:18789/webhook/outreach-pipeline",
                "authentication": "genericCredentialType",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({action: 'draft_followups', drafts: [{prospect_id: $json.prospect_id, body: $json.draft, channel: $json.channel, pain_bucket: $json.pain_bucket, model_used: $json.model_used}]}) }}",
                "options": {},
                "genericAuthType": "httpHeaderAuth"
            },
            "id": "f6473b40-d5de-4e21-b6b1-217817fc58fa",
            "credentials": {
                "httpHeaderAuth": {
                    "id": "sS3WHLXNPKSkpIC2",
                    "name": "openclaw-gateway-auth"
                }
            }
        },
        {
            "name": "Notify",
