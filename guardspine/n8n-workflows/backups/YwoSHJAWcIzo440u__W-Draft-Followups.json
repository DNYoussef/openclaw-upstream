                }
            }
        },
        {
            "name": "Notify Validation Failure",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "method": "POST",
                "url": "https://slack.com/api/chat.postMessage",
                "authentication": "genericCredentialType",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({channel: \"C0AKXAYJ41W\", text: \"\u26a0\ufe0f Followup blocked for \" + $json.name + \" (\" + $json.company + \") \u2014 \" + (($json.validation_errors || []).join(\", \") || \"validation_failed\") }) }}",
                "options": {},
                "genericAuthType": "httpHeaderAuth"
            },
            "id": "2915f5cd-dcdb-4bb3-8e24-256733791a75",
            "credentials": {
