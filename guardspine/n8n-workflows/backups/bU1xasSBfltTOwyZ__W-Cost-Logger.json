    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "log-cost",
                "responseMode": "onReceived",
                "options": {}
            },
            "id": "webhook-1",
            "name": "Cost Webhook",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2,
            "position": [
                240,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst usage = body.usage || {};\nconst model = (body.model || \"\").toLowerCase();\nconst rates = {\"haiku\": {in: 0.25, out: 1.25}, \"sonnet\": {in: 3.0, out: 15.0}, \"gpt-5.4-mini\": {in: 0.15, out: 0.60}, \"gpt-5.4\": {in: 2.50, out: 10.0}, \"gemini\": {in: 0.0, out: 0.0}};\nconst match = Object.entries(rates).find(([k]) => model.includes(k));\nconst r = match ? match[1] : {in: 0, out: 0};\nconst cost = (usage.prompt_tokens || 0)/1e6 * r.in + (usage.completion_tokens || 0)/1e6 * r.out;\nreturn [{json: {service: body.caller || \"n8n\", event_type: \"llm_call_complete\", payload: {model: body.model || \"unknown\", prompt_tokens: usage.prompt_tokens || 0, completion_tokens: usage.completion_tokens || 0, cost_usd: Math.round(cost * 1000000) / 1000000, caller: body.caller || \"unknown\"}}}];"
            },
            "id": "code-1",
            "name": "Calculate Cost",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                460,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "http://telemetry-api.railway.internal:8090/telemetry",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        },
                        {
                            "name": "Authorization",
                            "value": "***REDACTED***"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify($json) }}",
                "options": {}
            },
            "id": "http-1",
            "name": "Post to Telemetry",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                680,
                300
            ]
        }
    ],
    "connections": {
