        {
            "name": "Analyze Heartbeat",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                780,
                300
            ],
            "id": "analyze-8af4c14e",
            "parameters": {
                "jsCode": "const issuesRaw = $('Fetch Open Issues').first().json; const issues = Array.isArray(issuesRaw)?issuesRaw:(issuesRaw.items||issuesRaw.data||[]); const tele = $('Fetch Recent Telemetry').first().json.rows || []; const gov = $('Fetch Governance KPI').first().json;\nconst openMatch = issues.filter(i => ['todo','backlog','in_progress'].includes(i.status) && i.title === '[Heartbeat] CFO budget monitoring and cost analysis');\nconst billingErrors = tele.filter(e => String(e.event_type||'').includes('budget') || String(e.event_type||'').includes('billing')).length;\nconst llmEvents = tele.filter(e => /litellm|model_lab|openrouter/i.test(String(e.service||'')) || /token|model|completion/i.test(String(e.event_type||''))).length;\nconst bundles = Array.isArray(gov.rows) ? gov.rows.length : Number(gov.count || 0);\nconst critical = (Array.isArray(gov.rows)?gov.rows:[]).filter(r => ['L3','L4','critical','high'].includes(String(r.risk_tier||r.severity||'').toUpperCase())).length;\nconst priority = critical > 0 || billingErrors > 0 ? 'high' : llmEvents > 20 || bundles > 5 ? 'medium' : 'low';\nconst summary = { billingErrors, llmEvents, governanceBundles: bundles, criticalBundles: critical };\nconst description = ['Automated CFO heartbeat summary.','', 'Billing/budget-like telemetry events: ' + billingErrors, 'Model/LiteLLM-related events (recent): ' + llmEvents, 'Governance bundles in last 24h: ' + bundles, 'Critical/high bundles: ' + critical, 'Priority rationale: ' + priority].join('\n');\nreturn [{json:{ shouldCreate: openMatch.length===0, priority, dedupReason: openMatch.length ? 'existing_open_heartbeat' : null, summary, taskPayload:{ title:'[Heartbeat] CFO budget monitoring and cost analysis', description, status:'todo', priority } }}];"
            }
        },
        {
            "name": "Should Create Task?",
