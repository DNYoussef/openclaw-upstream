    "nodes": [
        {
            "name": "Schedule",
            "type": "n8n-nodes-base.scheduleTrigger",
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "cronExpression",
                            "expression": "0 10 * * 5"
                        }
                    ]
                }
            },
            "id": "ea4b8953-22a0-41a3-858e-bbeaab1a6f4d"
        },
        {
            "name": "Create Agent Task",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "url": "http://paperclip.railway.internal:3100/api/companies/75b694a8-5f7a-4b83-b12e-94fc378915c7/issues",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "{\"title\":\"[Agent] Weekly Strategic Scenario Planning\",\"description\":\"Produce a strategy memo from explicit evidence. Decompose as: (1) summarize outreach performance signals, (2) classify the week as growth, anomaly, or low-signal, (3) frame 1-2 strategic questions, (4) generate scenario options, (5) cite the metrics that support each option. Do not make live system changes. Output recommendations only.\",\"status\":\"todo\",\"priority\":\"medium\"}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "***REDACTED***"
                        }
                    ]
                },
                "options": {
                    "timeout": 15000
                }
            },
            "id": "9827c6ad-faf8-4d43-b89b-8730a4bf8ba0"
        },
        {
            "name": "Prepare Evidence",
            "type": "n8n-nodes-base.code",
            "parameters": {
                "jsCode": "const items = $input.all();\nconst outputItems = items.map(i => {\n  const j = {...i.json};\n  for (const k of Object.keys(j)) {\n    if (/token|key|secret|password|auth|bearer/i.test(k)) j[k] = '[REDACTED]';\n  }\n  return j;\n});\nconst first = outputItems[0] || {};\nreturn [{ json: {\n  workflow_name: $workflow.name,\n  execution_id: String($execution.id),\n  status: first.dispatch_status || 'created',\n  evidence_scope: first.evidence_scope || 'dispatch_only',\n  governance_note: first.governance_note || 'seal reflects dispatch only',\n  task_id: first.task_id || null,\n  items_count: items.length,\n  finished_at: new Date().toISOString(),\n  service_identity: 'n8n-workflows',\n  output_items: outputItems.slice(0, 10),\n  metadata: { node_count: $workflow.nodes?.length || 0 }\n}}];"
            },
            "id": "e85a55ae-23a4-42ec-a9aa-d601a5e94594"
        },
        {
            "name": "Seal via GuardSpine",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "url": "http://guardspine-internal.railway.internal:8000/api/v1/ops/evidence/seal",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify($json) }}",
                "options": {
                    "timeout": 10000
                }
            },
            "id": "da46e5bb-a763-488f-ad05-25b94c991175"
        },
        {
            "parameters": {
                "jsCode": "const j = $json || {};\nconst taskId = j.id || j.issueId || j.data?.id || null;\nif (!taskId) { throw new Error('Paperclip task creation returned no task id'); }\nreturn [{json:{...j, task_id: taskId, dispatch_status:'created', evidence_scope:'dispatch_only', governance_note:'seal reflects task dispatch, not task completion'}}];"
            },
            "id": "Validate_Task_Response_o6twa9",
            "name": "Validate Task Response",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                520,
                300
            ]
        }
    ],
    "connections": {
        "Schedule": {
