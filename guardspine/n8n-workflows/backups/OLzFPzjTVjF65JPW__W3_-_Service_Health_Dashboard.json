    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "minutes",
                            "minutesInterval": 30
                        }
                    ]
                }
            },
            "name": "Every 30 Min",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                200,
                300
            ],
            "id": "5f64c46f-7614-45d3-8bf9-7204094a5d83"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/kpi/kpi_health?weeks=4&limit=10",
                "sendHeaders": true,
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "httpHeaderAuth"
            },
            "name": "Query Health KPIs",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                420,
                250
            ],
            "id": "7c154e1e-5cf8-4d51-8e0b-62f80a1bbeeb",
            "credentials": {
                "httpHeaderAuth": {
                    "id": "huHftAKqWOtw7M34",
                    "name": "telemetry-api-auth"
                }
            }
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/kpi/kpi_automation?weeks=4&limit=10",
                "sendHeaders": true,
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "httpHeaderAuth"
            },
            "name": "Query Automation KPIs",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                420,
                400
            ],
            "id": "2ebcce56-7cf2-4424-b9fe-e9100d5ec5de",
            "credentials": {
                "httpHeaderAuth": {
                    "id": "huHftAKqWOtw7M34",
                    "name": "telemetry-api-auth"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "const healthItems = $('Query Health KPIs').all();\nconst autoItems = $('Query Automation KPIs').all();\n\nconst health = (healthItems.length > 0) ? healthItems[0].json : {};\nconst auto = (autoItems.length > 0) ? autoItems[0].json : {};\n\nconst alerts = [];\nif ((health.checks_failed || 0) > 0) alerts.push({severity: 'high', msg: health.checks_failed + ' health checks failed'});\nif ((health.crashes || 0) > 0) alerts.push({severity: 'critical', msg: health.crashes + ' service crashes detected'});\nif ((auto.failed_heartbeats || 0) > 3) alerts.push({severity: 'medium', msg: auto.failed_heartbeats + ' agent heartbeat failures'});\n\nreturn [{json: {alerts, alert_count: alerts.length, health_summary: health, automation_summary: auto}}];"
            },
            "name": "Check Thresholds",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                640,
                300
            ],
            "id": "de7e7f71-1f71-40f1-9ad1-f37d993989af"
        },
        {
            "parameters": {
                "conditions": {
                    "boolean": [
                        {
                            "value1": "={{ $json.all_green }}",
                            "value2": false
                        }
                    ]
                }
            },
            "name": "Any Alerts?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                860,
                300
            ],
            "id": "4bfd23ef-5d7e-4030-afbe-5e0d27a08d97"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/telemetry",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "{\"service\": \"infrastructure\", \"event_type\": \"health_alert\", \"payload\": {\"alerts\": \"={{ JSON.stringify($json.alerts) }}\", \"alert_count\": \"={{ $json.alert_count }}\"}}",
                "sendHeaders": true,
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "httpHeaderAuth"
            },
            "name": "Emit Health Alert",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1080,
                200
            ],
            "id": "9630de3b-c771-4f7a-bbc5-ae984d7dbf70",
            "credentials": {
                "httpHeaderAuth": {
                    "id": "huHftAKqWOtw7M34",
                    "name": "telemetry-api-auth"
                }
            }
        },
        {
            "parameters": {},
            "name": "Error Trigger",
            "type": "n8n-nodes-base.errorTrigger",
            "typeVersion": 1,
            "position": [
                200,
                600
            ],
            "id": "7ae0676b-27a3-4065-a5a8-331dec05f219"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/telemetry",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "{\"service\": \"n8n\", \"event_type\": \"workflow_error\", \"payload\": {\"workflow\": \"W3 - Service Health Dashboard\", \"error\": \"={{ $json.execution.error.message }}\", \"node\": \"={{ $json.execution.lastNodeExecuted }}\", \"timestamp\": \"={{ $now.toISO() }}\", \"execution_id\": \"={{ $json.execution.id }}\"}}",
                "sendHeaders": true,
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "httpHeaderAuth"
            },
            "name": "POST Error to Telemetry",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                420,
                600
            ],
            "id": "894bcea6-313b-4815-8161-715b25caea1a",
            "credentials": {
                "httpHeaderAuth": {
                    "id": "huHftAKqWOtw7M34",
                    "name": "telemetry-api-auth"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "const items = $input.all();\nconst outputItems = items.map(i => {\n  const j = {...i.json};\n  // Redact anything that looks like a secret\n  for (const k of Object.keys(j)) {\n    if (/token|key|secret|password|auth|bearer/i.test(k)) j[k] = '[REDACTED]';\n  }\n  return j;\n});\n\nreturn [{ json: {\n  workflow_name: $workflow.name,\n  execution_id: String($execution.id),\n  status: 'completed',\n  items_count: items.length,\n  finished_at: new Date().toISOString(),\n  service_identity: 'n8n-workflows',\n  output_items: outputItems.slice(0, 10),\n  metadata: { node_count: $workflow.nodes?.length || 0 }\n}}];"
            },
            "name": "Prepare Evidence",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1330,
                368
            ],
            "onError": "continueRegularOutput",
            "id": "4734b280-84eb-48c4-be48-2c359d219228"
        },
        {
            "parameters": {
                "url": "https://api.guardspine.ai/api/v1/ops/evidence/seal",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ diff_hash: ('n8n:' + $workflow.name + ':' + $execution.id).slice(0, 250), approver_id: 'n8n-workflows', policy_ref: 'ops-automation', metadata: { payload: $json, workflow: $workflow.name, execution_id: $execution.id } }) }}",
                "options": {
                    "timeout": 10000
                },
                "sendHeaders": true,
                "specifyHeaders": "keypair",
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "X-Service-Key",
                            "value": "={{ $env.GUARDSPINE_SERVICE_KEY }}"
                        },
                        {
                            "name": "X-Service-Name",
                            "value": "n8n"
                        }
                    ]
                }
            },
            "name": "Seal via GuardSpine",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1580,
                318
            ],
            "id": "ae540d63-ddc1-4697-a8cb-267ef90fd5c8"
        }
