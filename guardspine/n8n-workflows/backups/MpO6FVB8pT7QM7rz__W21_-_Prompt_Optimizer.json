            "name": "Fetch Recent Errors",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                640,
                300
            ],
            "id": "11c668dc-3311-4001-9f19-d96cd0aa93b9"
        },
        {
            "parameters": {
                "jsCode": "const heartbeats = $('Fetch Agent Heartbeats').first().json;\nconst errors = $('Fetch Recent Errors').first().json;\n\nconst hb_rows = heartbeats.rows || [];\nconst err_rows = errors.rows || [];\n\n// Group heartbeats by agent\nconst agents = {};\nfor (const r of hb_rows) {\n  if (!agents[r.name]) agents[r.name] = {success: 0, fail: 0, total: 0};\n  agents[r.name].total++;\n  if (r.status === 'succeeded') agents[r.name].success++;\n  else agents[r.name].fail++;\n}\n\n// Calculate quality scores\nconst quality_report = [];\nfor (const [name, stats] of Object.entries(agents)) {\n  const rate = stats.total > 0 ? stats.success / stats.total : 0;\n  quality_report.push({\n    agent: name,\n    success_rate: Math.round(rate * 100),\n    total_runs: stats.total,\n    failures: stats.fail,\n    needs_attention: rate < 0.8,\n    prompt_optimization_ready: stats.total >= 20\n  });\n}\n\n// Error analysis\nconst error_count = err_rows.filter(r => r.event_type === 'workflow_error').length;\n\nconst report = {\n  week_ending: new Date().toISOString().split('T')[0],\n  agents_analyzed: quality_report.length,\n  agents_needing_attention: quality_report.filter(a => a.needs_attention).length,\n  agents_ready_for_optimization: quality_report.filter(a => a.prompt_optimization_ready).length,\n  workflow_errors_this_week: error_count,\n  agent_details: quality_report,\n  dspy_recommendation: quality_report.some(a => a.prompt_optimization_ready && a.needs_attention)\n    ? 'Run DSPy SIMBA on degraded agents: python scripts/dspy/optimize_prompts.py'\n    : 'No agents meet optimization threshold (20+ runs + <80% success). Collecting more data.'\n};\n\nreturn [{json: report}];"
            },
            "name": "Analyze Agent Quality",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                860,
