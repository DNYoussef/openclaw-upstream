                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "{\"query_name\": \"telemetry_by_service\", \"params\": {\"service\": \"n8n\", \"limit\": 50}}",
