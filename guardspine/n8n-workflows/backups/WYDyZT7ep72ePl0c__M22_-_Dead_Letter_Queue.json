        {
            "parameters": {
                "jsCode": "const raw = $input.first().json || {};\nconst executions = Array.isArray(raw.data) ? raw.data : (Array.isArray(raw) ? raw : []);\nconst breakdown = {};\nconst retryableIds = [];\nconst escalations = [];\n\nfunction classifyError(execution) {\n  const text = JSON.stringify(execution).toLowerCase();\n  if (/timeout|timed out|econnreset|socket hang up|network/.test(text)) return 'network_timeout';\n  if (/auth|unauthorized|forbidden|invalid api key|credentials?/.test(text)) return 'auth_failure';\n  if (/json|schema|validation|bad request|payload|parse/.test(text)) return 'data_error';\n  return 'unknown';\n}\n\nfor (const ex of executions) {\n  const type = classifyError(ex);\n  breakdown[type] = (breakdown[type] || 0) + 1;\n  if (type === 'network_timeout') retryableIds.push(ex.id);\n  if (type !== 'network_timeout') escalations.push({id: ex.id, workflow: ex.workflowName || ex.workflow?.name || 'unknown', error_type: type});\n}\n\nreturn [{json:{\n  stream: 'dead_letter_queue',\n  event_type: 'dead_letter_snapshot',\n  workflow_name: $workflow.name,\n  execution_id: String($execution.id),\n  status: executions.length ? 'errors_found' : 'clean',\n  finished_at: new Date().toISOString(),\n  errors_found: executions.length,\n  retryable_count: retryableIds.length,\n  escalated_count: escalations.length,\n  retryable_execution_ids: retryableIds.slice(0, 20),\n  error_type_breakdown: breakdown,\n  escalation_candidates: escalations.slice(0, 20)\n}}];"
            },
