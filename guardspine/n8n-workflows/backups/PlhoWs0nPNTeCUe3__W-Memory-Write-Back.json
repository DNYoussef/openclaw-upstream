    "nodes": [
        {
            "name": "Webhook Trigger",
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 2,
            "position": [
                0,
                0
            ],
            "webhookId": "memory-write-back",
            "parameters": {
                "path": "memory-write-back",
                "responseMode": "responseNode",
                "options": {}
            },
            "id": "0f0b7d83-8494-41be-899f-bbc9b6cf6d9b"
        },
        {
            "name": "Validate & Structure",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                220,
                0
            ],
            "parameters": {
                "jsCode": "// Section X.B Memory Write-Back Schema Validator\n// Any workflow calls this to store structured memory\n\nconst body = $input.first().json.body || $input.first().json;\n\nconst VALID_TYPES = ['insight', 'SOP', 'pattern', 'objection', 'playbook', 'risk', 'decision'];\n\n// Validate required fields\nif (!body.title) throw new Error('Memory update requires: title');\nif (!body.type) throw new Error('Memory update requires: type (insight/SOP/pattern/objection/playbook/risk/decision)');\nif (!body.summary) throw new Error('Memory update requires: summary');\n\nconst type = body.type.toLowerCase();\nif (!VALID_TYPES.includes(type)) {\n  throw new Error(`Invalid type: ${type}. Must be one of: ${VALID_TYPES.join(', ')}`);\n}\n\n// Build the structured memory update\nconst update = {\n  title: body.title,\n  type: type,\n  summary: body.summary,\n  why_it_matters: body.why_it_matters || body.why || '',\n  trigger_conditions: body.trigger_conditions || body.trigger || '',\n  recommended_future_use: body.recommended_future_use || body.future_use || '',\n  source_workflow: body.source_workflow || 'unknown',\n  execution_id: body.execution_id || '',\n  timestamp: new Date().toISOString(),\n  confidence: body.confidence || 'medium',\n  tags: body.tags || [type]\n};\n\n// Build the formatted memory text\nconst memoryText = `MEMORY UPDATE:\\n` +\n  `- Title: ${update.title}\\n` +\n  `- Type: ${update.type}\\n` +\n  `- Summary: ${update.summary}\\n` +\n  `- Why it matters: ${update.why_it_matters}\\n` +\n  `- Trigger conditions: ${update.trigger_conditions}\\n` +\n  `- Recommended future use: ${update.recommended_future_use}\\n` +\n  `- Source: ${update.source_workflow} @ ${update.timestamp}\\n` +\n  `- Confidence: ${update.confidence}`;\n\nreturn [{ json: { ...update, memory_text: memoryText } }];"
            },
            "id": "0f8aac0f-9c7c-4878-8e88-8c2c3a8820db"
        },
        {
            "name": "Store in Memory MCP",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                440,
                -100
            ],
            "parameters": {
                "method": "POST",
                "url": "http://memory-mcp.railway.internal:8080/tools/memory_store",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ text: $json.memory_text, metadata: { type: $json.type, title: $json.title, source: $json.source_workflow, timestamp: $json.timestamp, confidence: $json.confidence } }) }}",
                "options": {
                    "timeout": 10000
                }
            },
            "onError": "continueRegularOutput",
            "id": "01aca9c8-331b-4fd8-9589-af1bd82a82c0"
        },
        {
            "name": "Log to Telemetry",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                440,
                100
            ],
            "parameters": {
                "method": "POST",
                "url": "http://telemetry-api.railway.internal:8090/telemetry",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ service: 'n8n', event_type: 'memory_write_back', payload: { title: $json.title, type: $json.type, source: $json.source_workflow } }) }}",
                "options": {
                    "timeout": 5000
                }
            },
            "onError": "continueRegularOutput",
            "id": "dc4244de-2267-42f9-884c-c5701b078788"
        },
        {
            "name": "Build Response",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                660,
                0
            ],
            "parameters": {
                "jsCode": "const mcp = $('Store in Memory MCP').first().json;\nconst mcp_ok = !mcp.detail; // no detail = success\n\nreturn [{\n  json: {\n    status: 'stored',\n    memory_mcp: mcp_ok ? 'ok' : ('error: ' + (mcp.detail || 'unknown')),\n    title: $('Validate & Structure').first().json.title,\n    type: $('Validate & Structure').first().json.type,\n    timestamp: $('Validate & Structure').first().json.timestamp\n  }\n}];"
            },
            "id": "945db8a2-33c2-435c-b63b-71f0ed55d2d0"
        },
        {
            "name": "Respond",
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1.1,
            "position": [
                880,
                0
            ],
            "parameters": {
                "respondWith": "json",
                "responseBody": "={{ JSON.stringify($json) }}"
            },
            "id": "30c64362-6475-4f28-abe8-d788fa4a4e10"
        }
    ],
