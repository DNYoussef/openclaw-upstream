        {
            "name": "Prepare Evidence",
            "type": "n8n-nodes-base.code",
            "parameters": {
                "jsCode": "const items = $input.all(); const outputItems = items.map(i=>{const j={...i.json}; for (const k of Object.keys(j)) if (/token|key|secret|password|auth|bearer/i.test(k)) j[k]='[REDACTED]'; return j;}); const first=outputItems[0]||{}; return [{json:{workflow_name:$workflow.name, execution_id:String($execution.id), status:(first.validation_ok===false||first.brief_valid===false)?'validation_failed':'completed', items_count:items.length, finished_at:new Date().toISOString(), service_identity:'n8n-workflows', output_items:outputItems.slice(0,10), metadata:{node_count:$workflow.nodes?.length||0, attention_mode:first.attention_mode||'normal', brief_length:first.brief_length||0}}}];"
            },
            "id": "d7fa8839-9d03-4609-90a0-a74828fdd2e6"
        },
        {
            "name": "Seal via GuardSpine",
            "type": "n8n-nodes-base.httpRequest",
            "parameters": {
                "url": "http://guardspine-internal.railway.internal:8000/api/v1/ops/evidence/seal",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify($json) }}",
                "options": {
                    "timeout": 10000
                }
            },
            "id": "156c6a24-97e2-40f5-8618-4d3d554598b7"
        },
        {
            "parameters": {
                "jsCode": "const j = $json || {}; const keys = Object.keys(j); const hasData = keys.length > 0; const critical = Number(j.critical_count || 0); return [{json:{...j, validation_ok: hasData, critical_count: critical, attention_mode: critical > 0 ? 'critical' : 'normal'}}];"
            },
