    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "cronExpression",
                            "expression": "30 2 * * *"
                        }
                    ]
                }
            },
            "name": "Daily 2:30 AM UTC",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                200,
                300
            ],
            "id": "606962d2-9685-40e2-85cb-6fc8bce3be16"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/query",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "{\"query_name\": \"recent_telemetry\", \"params\": {\"limit\": 200}}"
            },
            "name": "Fetch Recent Telemetry",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                420,
                300
            ],
            "id": "82010aae-5835-4bd0-a714-8e84074138ea"
        },
        {
            "parameters": {
                "jsCode": "const items = $('Fetch Recent Telemetry').all().map(i => i.json);\n\nconst KNOWN_EVENT_TYPES = [\n  'health_check', 'health_alert',\n  'workflow_error',\n  'drift_detected', 'drift_clean',\n  'budget_ok', 'budget_alert',\n  'stale_data_alert', 'data_fresh',\n  'secret_leak_detected', 'secrets_clean',\n  'anomaly_detected', 'logs_clean',\n  'signal_check',\n  'retention_audit',\n  'agent_degraded', 'agents_healthy',\n  'performance_report',\n  'heartbeat', 'agent_heartbeat',\n  'ceo_briefing',\n  'content_scheduled', 'content_published',\n  'partner_scan', 'partner_found',\n  'pipeline_metrics', 'pipeline_report',\n  'notification_sent', 'notification_routed',\n  'pr_monitor', 'pr_alert',\n  'data_sync', 'sync_complete',\n  'outreach_signal', 'outreach_sent',\n  'cmo_report', 'lead_scored'\n];\n\nconst anomalies = [];\nconst eventTypeCounts = {};\nconst now = new Date();\nconst twentyFourHoursMs = 24 * 60 * 60 * 1000;\nlet errorCount24h = 0;\n\nfor (const evt of items) {\n  const evtType = evt.event_type || 'unknown';\n  eventTypeCounts[evtType] = (eventTypeCounts[evtType] || 0) + 1;\n\n  // Count errors in last 24h\n  const ts = new Date(evt.created_at || evt.timestamp || evt.ts || 0);\n  const ageMs = now.getTime() - ts.getTime();\n  if (ageMs <= twentyFourHoursMs && (evtType.includes('error') || evtType.includes('alert') || evtType.includes('failed'))) {\n    errorCount24h++;\n  }\n}\n\n// Check for unknown event types\nfor (const [evtType, count] of Object.entries(eventTypeCounts)) {\n  if (!KNOWN_EVENT_TYPES.includes(evtType)) {\n    anomalies.push({\n      type: 'unknown_event_type',\n      event_type: evtType,\n      count: count,\n      detail: 'Event type not in known list'\n    });\n  }\n}\n\n// Check for error spike\nif (errorCount24h > 10) {\n  anomalies.push({\n    type: 'error_spike',\n    error_count: errorCount24h,\n    threshold: 10,\n    detail: 'More than 10 error/alert events in last 24 hours'\n  });\n}\n\nreturn [{\n  json: {\n    anomalies: anomalies,\n    anomaly_count: anomalies.length,\n    event_type_counts: eventTypeCounts,\n    error_count_24h: errorCount24h,\n    events_scanned: items.length,\n    checked_at: now.toISOString()\n  }\n}];"
            },
            "name": "Analyze Log Anomalies",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                640,
                300
            ],
            "id": "2657ef6c-4be2-4243-914b-ac54c7df3ccd"
        },
        {
            "parameters": {
                "conditions": {
                    "number": [
                        {
                            "value1": "={{ $json.anomaly_count }}",
                            "operation": "larger",
                            "value2": 0
                        }
                    ]
                }
            },
            "name": "Anomalies Found?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                860,
                300
            ],
            "id": "7203f9c4-2b01-46c3-8be9-b20dbfa3e408"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/telemetry",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "={\"service\": \"log-scanner\", \"event_type\": \"anomaly_detected\", \"payload\": {\"anomalies\": {{ JSON.stringify($json.anomalies) }}, \"anomaly_count\": {{ $json.anomaly_count }}, \"error_count_24h\": {{ $json.error_count_24h }}, \"events_scanned\": {{ $json.events_scanned }}, \"checked_at\": \"{{ $json.checked_at }}\"}}"
            },
            "name": "Emit Anomaly Alert",
            "type": "n8n-nodes-base.httpRequest",
