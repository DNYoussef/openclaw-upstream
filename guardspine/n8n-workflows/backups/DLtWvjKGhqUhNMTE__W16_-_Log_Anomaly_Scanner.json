                "jsonBody": "={\"service\": \"log-scanner\", \"event_type\": \"logs_clean\", \"payload\": {\"events_scanned\": {{ $json.events_scanned }}, \"error_count_24h\": {{ $json.error_count_24h }}, \"checked_at\": \"{{ $json.checked_at }}\"}}"
            },
