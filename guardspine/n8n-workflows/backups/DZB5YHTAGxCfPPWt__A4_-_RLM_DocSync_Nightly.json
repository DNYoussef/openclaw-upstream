            "name": "Schedule",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                250,
                300
            ],
            "id": "d8018f85-0354-4446-9a07-517a05a8c8f3"
        },
        {
            "parameters": {
                "url": "http://paperclip.railway.internal:3100/api/companies/75b694a8-5f7a-4b83-b12e-94fc378915c7/issues",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "{\"title\": \"[Agent] RLM DocSync Verification\", \"description\": \"Read guardspine.docs.yaml manifest. Verify each claim against codebase. Report violations: claim ID, doc says vs code does. Draft updates for reality-first docs.\", \"status\": \"todo\", \"priority\": \"medium\"}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "***REDACTED***"
                        }
                    ]
                },
                "options": {
                    "timeout": 15000
                }
            },
            "name": "Create Agent Task",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                480,
                300
            ],
            "id": "477a8b64-ba6e-47e7-a412-e2fe99040952"
        },
        {
            "parameters": {
                "jsCode": "const items = $input.all();\nconst outputItems = items.map(i => {\n  const j = {...i.json};\n  // Redact anything that looks like a secret\n  for (const k of Object.keys(j)) {\n    if (/token|key|secret|password|auth|bearer/i.test(k)) j[k] = '[REDACTED]';\n  }\n  return j;\n});\n\nreturn [{ json: {\n  workflow_name: $workflow.name,\n  execution_id: String($execution.id),\n  status: 'completed',\n  items_count: items.length,\n  finished_at: new Date().toISOString(),\n  service_identity: 'n8n-workflows',\n  output_items: outputItems.slice(0, 10),\n  metadata: { node_count: $workflow.nodes?.length || 0 }\n}}];"
            },
            "name": "Prepare Evidence",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                730,
                300
            ],
            "onError": "continueRegularOutput",
            "id": "847947e6-1c98-4a95-a60d-744049f5d36f"
        },
        {
            "parameters": {
                "url": "https://api.guardspine.ai/api/v1/ops/evidence/seal",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({ diff_hash: ('n8n:' + $workflow.name + ':' + $execution.id).slice(0, 250), approver_id: 'n8n-workflows', policy_ref: 'ops-automation', metadata: { payload: $json, workflow: $workflow.name, execution_id: $execution.id } }) }}",
                "options": {
                    "timeout": 10000
                },
                "sendHeaders": true,
                "specifyHeaders": "keypair",
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "X-Service-Key",
                            "value": "={{ $env.GUARDSPINE_SERVICE_KEY }}"
                        },
                        {
                            "name": "X-Service-Name",
                            "value": "n8n"
                        }
                    ]
                }
            },
            "name": "Seal via GuardSpine",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
