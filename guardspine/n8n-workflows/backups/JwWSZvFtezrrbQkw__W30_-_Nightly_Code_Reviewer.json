            },
            "name": "Daily 0:30 AM UTC",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                200,
                300
            ],
            "id": "ba0ca85f-393c-442e-94de-dfde716ff1cf"
        },
        {
            "parameters": {
                "jsCode": "// Rotate through services based on day of year\nconst services = [\n  {name: 'telemetry-api', path: 'guardspine/telemetry-api/app.py', focus: 'SQL injection defense, connection pooling, error handling'},\n  {name: 'soak-monitor', path: 'guardspine/soak-monitor/health-check.sh', focus: 'service coverage, timeout handling, health data storage'},\n  {name: 'decision-engine', path: 'guardspine/decision-engine/router.py', focus: 'solver stubs, error handling, dependency checks'},\n  {name: 'mirofish-sim', path: 'guardspine/mirofish-sim/app.py', focus: 'resource limits, job cleanup, error handling'},\n  {name: 'n8n-pipeline-plugin', path: 'guardspine/extensions/n8n-pipeline/plugin.js', focus: 'error handling, API patterns, security'},\n  {name: 'guardspine-plugin', path: 'guardspine/extensions/guardspine/plugin.js', focus: 'L4 approvals, council logic, security'},\n  {name: 'litellm-config', path: 'guardspine/litellm/config.yaml', focus: 'model routing, fallback chains, cost optimization'},\n  {name: 'agents-shared-context', path: 'guardspine/agents/SHARED-CONTEXT.md', focus: 'agent instructions clarity, accuracy, completeness'},\n  {name: 'cmo-prompt', path: 'guardspine/agents/cmo-system-prompt.md', focus: 'outreach quality, PMC decomposition, voice rules'},\n  {name: 'content-prompt', path: 'guardspine/agents/content-system-prompt.md', focus: 'content quality, LinkedIn patterns, hook effectiveness'},\n  {name: 'cmo-outreach-workflow', path: 'guardspine/n8n-workflows/definitions/cmo-outreach-pipeline.json', focus: 'node connections, error handling, Paperclip auth'},\n  {name: 'w3-health-workflow', path: 'guardspine/n8n-workflows/definitions/w3-health-dashboard.json', focus: 'query patterns, threshold logic, alert quality'},\n  {name: 'dockerfiles', path: 'guardspine/telemetry-api/Dockerfile', focus: 'security (non-root user, pinned versions), build efficiency'}\n];\n\nconst dayOfYear = Math.floor((Date.now() - new Date(new Date().getFullYear(), 0, 0)) / (24 * 60 * 60 * 1000));\nconst index = dayOfYear % services.length;\nconst tonight = services[index];\n\nreturn [{json: {\n  service: tonight.name,\n  file_path: tonight.path,\n  review_focus: tonight.focus,\n  cycle_day: index + 1,\n  cycle_total: services.length\n}}];"
            },
            "name": "Determine Tonight's Service",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                420,
                300
            ],
            "id": "6a981059-2b29-4ed6-a758-7d96bc035762"
        },
        {
            "parameters": {
                "url": "=https://api.github.com/repos/DNYoussef/openclaw-upstream/contents/{{ $json.file_path }}",
                "method": "GET",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Accept",
                            "value": "application/vnd.github.v3.raw"
                        }
                    ]
                }
            },
            "name": "Fetch Code from GitHub",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                640,
                300
            ],
            "id": "d9d18e91-704c-47fb-a145-893af1c94f35"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/telemetry",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "={\"service\": \"code-reviewer\", \"event_type\": \"review_requested\", \"payload\": {\"service_name\": \"{{ $('Determine Tonight\\'s Service').first().json.service }}\", \"file_path\": \"{{ $('Determine Tonight\\'s Service').first().json.file_path }}\", \"review_focus\": \"{{ $('Determine Tonight\\'s Service').first().json.review_focus }}\", \"cycle_day\": {{ $('Determine Tonight\\'s Service').first().json.cycle_day }}, \"code_length\": {{ typeof $('Fetch Code from GitHub').first().json === 'string' ? $('Fetch Code from GitHub').first().json.length : 0 }}, \"code_snippet_start\": \"{{ typeof $('Fetch Code from GitHub').first().json === 'string' ? $('Fetch Code from GitHub').first().json.substring(0, 500).replace(/\\\"/g, '\\\\\"').replace(/\\n/g, '\\\\n') : 'not a string' }}\"}}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "***REDACTED***"
                        }
                    ]
                }
            },
            "name": "Log Code for CTO Review",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                860,
                300
            ],
            "id": "66a45f90-fb5f-46d5-83c0-3fccfa5550d3"
        },
        {
            "parameters": {},
