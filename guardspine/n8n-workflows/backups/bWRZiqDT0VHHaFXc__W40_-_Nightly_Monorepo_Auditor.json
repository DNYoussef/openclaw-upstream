    "name": "W40 - Nightly Monorepo Auditor",
    "description": null,
    "active": true,
    "isArchived": false,
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "triggerAtHour": 1,
                            "triggerAtMinute": 45
                        }
                    ]
                }
            },
            "id": "schedule-1",
            "name": "Nightly 1:45 UTC",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                240,
                300
            ]
        },
        {
            "parameters": {
                "jsCode": "const date = new Date().toISOString().split('T')[0];\nconst dayOfYear = Math.floor((new Date() - new Date(new Date().getFullYear(), 0, 0)) / 86400000);\nconst services = ['telemetry-api/app.py', 'decision-engine/router.py', 'mirofish-sim/app.py', 'soak-monitor/health-check.sh', 'litellm/config.yaml', 'agents/SHARED-CONTEXT.md', 'agents/ceo-system-prompt.md', 'agents/cmo-system-prompt.md', 'agents/cto-system-prompt.md', 'extensions/guardspine/plugin.js', 'n8n-workflows/config/outreach-templates.json', 'agents/staff-engineer-system-prompt.md', 'agents/qa-engineer-system-prompt.md'];\nconst startIdx = dayOfYear % services.length;\nconst files = [];\nfor (let i = 0; i < 5; i++) { files.push(services[(startIdx + i) % services.length]); }\nreturn [{json: {date, branch: 'main', files, audit_focus: dayOfYear % 3 === 0 ? 'bugs' : dayOfYear % 3 === 1 ? 'simplifications' : 'optimizations'}}];"
            },
            "id": "code-1",
            "name": "Select Audit Scope",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                460,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "http://paperclip.railway.internal:3100/api/companies/75b694a8-5f7a-4b83-b12e-94fc378915c7/issues",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "***REDACTED***"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({title: 'Nightly Audit ' + $json.date + ': ' + $json.branch + ' (' + $json.files.length + ' files)', description: JSON.stringify({branch: $json.branch, files: $json.files, audit_focus: $json.audit_focus}), assigneeAgentId: '725b6347-7724-4383-b2a7-96b198749a68', labels: ['nightly-audit']}) }}",
                "options": {}
            },
            "id": "http-1",
            "name": "Create Audit Issue",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                680,
                300
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "http://telemetry-api.railway.internal:8090/telemetry",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Content-Type",
                            "value": "application/json"
                        },
                        {
                            "name": "Authorization",
                            "value": "***REDACTED***"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify({service: 'nightly-audit', event_type: 'audit_requested', payload: {branch: $json.branch, file_count: $json.files.length, scope: $json.audit_focus}}) }}",
                "options": {}
            },
            "id": "http-2",
            "name": "Log to Telemetry",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                900,
                300
            ]
        }
    ],
