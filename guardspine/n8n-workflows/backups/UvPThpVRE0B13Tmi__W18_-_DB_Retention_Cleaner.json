    "name": "W18 - DB Retention Cleaner",
    "description": null,
    "active": true,
    "isArchived": false,
    "nodes": [
        {
            "parameters": {
                "rule": {
                    "interval": [
                        {
                            "field": "cronExpression",
                            "expression": "30 1 * * 0"
                        }
                    ]
                }
            },
            "name": "Sunday 1:30 AM UTC",
            "type": "n8n-nodes-base.scheduleTrigger",
            "typeVersion": 1.2,
            "position": [
                200,
                300
            ],
            "id": "d5294082-3d82-4eba-af9b-322854e228c0"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/query",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "{\"query_name\": \"recent_telemetry\", \"params\": {\"limit\": 1}}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "***REDACTED***"
                        }
                    ]
                }
            },
            "name": "Verify DB Connectivity",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                420,
                300
            ],
            "id": "4d651198-875e-4c67-b14c-e6354dee65e6"
        },
        {
            "parameters": {
                "jsCode": "const dbCheck = $('Verify DB Connectivity').all();\n\nif (dbCheck.length === 0) {\n  return [{\n    json: {\n      status: 'error',\n      message: 'DB connectivity check returned no results',\n      would_purge_telemetry: 0,\n      would_purge_heartbeats: 0\n    }\n  }];\n}\n\n// NOTE: Actual row counts for old data require a dedicated telemetry-api\n// endpoint (POST /maintenance/purge). For now we log the intent and\n// recommend manual review.\n//\n// Retention policy:\n//   telemetry_events: keep 90 days\n//   heartbeat_run_events: keep 30 days\n\nconst now = new Date();\nconst retentionPolicy = {\n  telemetry_events: { retention_days: 90, cutoff: new Date(now.getTime() - 90 * 24 * 60 * 60 * 1000).toISOString() },\n  heartbeat_runs: { retention_days: 30, cutoff: new Date(now.getTime() - 30 * 24 * 60 * 60 * 1000).toISOString() }\n};\n\nreturn [{\n  json: {\n    status: 'audit_only',\n    message: 'Retention audit logged. Actual deletion requires POST /maintenance/purge endpoint.',\n    retention_policy: retentionPolicy,\n    would_purge_telemetry: 'unknown - requires purge endpoint',\n    would_purge_heartbeats: 'unknown - requires purge endpoint',\n    db_connected: true,\n    checked_at: now.toISOString()\n  }\n}];"
            },
            "name": "Build Cleanup Summary",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                640,
                300
            ],
            "id": "6c230a37-3eb3-4ea5-9186-11f3ef8833fc"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/telemetry",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "={\"service\": \"maintenance\", \"event_type\": \"retention_audit\", \"payload\": {\"status\": \"{{ $json.status }}\", \"message\": \"{{ $json.message }}\", \"retention_policy\": {{ JSON.stringify($json.retention_policy) }}, \"db_connected\": {{ $json.db_connected }}, \"checked_at\": \"{{ $json.checked_at }}\"}}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "***REDACTED***"
                        }
                    ]
                }
            },
            "name": "Log Retention Audit",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                860,
                300
            ],
            "id": "387f25eb-6253-4cef-ba84-12bc8d15e26e"
        },
        {
            "parameters": {},
            "name": "Error Trigger",
            "type": "n8n-nodes-base.errorTrigger",
            "typeVersion": 1,
            "position": [
                200,
                600
            ],
            "id": "9ce23414-c1ab-4b21-93df-52cbae904f0a"
        },
        {
            "parameters": {
                "url": "http://telemetry-api.railway.internal:8090/telemetry",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "contentType": "json",
                "jsonBody": "{\"service\": \"n8n\", \"event_type\": \"workflow_error\", \"payload\": {\"workflow\": \"W18 - DB Retention Cleaner\", \"error\": \"={{ $json.execution.error.message }}\", \"node\": \"={{ $json.execution.lastNodeExecuted }}\", \"timestamp\": \"={{ $now.toISO() }}\", \"execution_id\": \"={{ $json.execution.id }}\"}}",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "***REDACTED***"
                        }
                    ]
                }
            },
            "name": "POST Error to Telemetry",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                420,
                600
            ],
            "id": "adff70c3-b973-48a7-a546-0f0289b0fbcf"
        },
        {
            "parameters": {
                "jsCode": "const items = $input.all();\nconst outputItems = items.map(i => {\n  const j = {...i.json};\n  // Redact anything that looks like a secret\n  for (const k of Object.keys(j)) {\n    if (/token|key|secret|password|auth|bearer/i.test(k)) j[k] = '[REDACTED]';\n  }\n  return j;\n});\n\nreturn [{ json: {\n  workflow_name: $workflow.name,\n  execution_id: String($execution.id),\n  status: 'completed',\n  items_count: items.length,\n  finished_at: new Date().toISOString(),\n  service_identity: 'n8n-workflows',\n  output_items: outputItems.slice(0, 10),\n  metadata: { node_count: $workflow.nodes?.length || 0 }\n}}];"
            },
            "name": "Prepare Evidence",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1110,
                400
            ],
            "onError": "continueRegularOutput",
            "id": "8bf4dded-4bcb-4483-bc43-7bef608f7c8f"
        },
        {
            "parameters": {
                "url": "http://guardspine-internal.railway.internal:8000/api/v1/ops/evidence/seal",
                "method": "POST",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={{ JSON.stringify($json) }}",
                "options": {
                    "timeout": 10000
                }
            },
            "name": "Seal via GuardSpine",
            "type": "n8n-nodes-base.httpRequest",
