        },
        {
            "name": "Scan Reddit Engagement",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                470,
                300
            ],
            "parameters": {
                "jsCode": "// Scan for engagement on posted messages\n// This queries outreach.db for messages with posted_url\n// and checks Reddit API for upvotes/comments\n\nconst results = [];\n\n// For now, generate a summary of what needs tracking\n// Reddit JSON API: GET {url}.json returns upvotes, comments\nconst platforms = [\"reddit\", \"devto\", \"linkedin\"];\nconst now = new Date().toISOString();\n\nresults.push({\n  json: {\n    scan_time: now,\n    platforms_checked: platforms,\n    action: \"scan_engagement\",\n    message: \"Daily outreach engagement scan completed\"\n  }\n});\n\nreturn results;"
            },
            "id": "6f30fc4d-f491-4ffe-8988-764dfa253c6d"
        },
        {
            "name": "Query Posted Messages",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                690,
                300
            ],
            "parameters": {
                "method": "POST",
                "url": "http://openclaw.railway.internal:18789/webhook/outreach-pipeline",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "httpHeaderAuth",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\"action\":\"check_response_signals\"}",
                "options": {}
            },
            "credentials": {
                "httpHeaderAuth": {
                    "id": "q1AXODdRzGeqWsDy",
                    "name": "openclaw-auth"
                }
            },
            "id": "1aebc3a1-92d1-4ce9-8049-a2d02b855d5a"
        },
        {
            "name": "Calculate Scores",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                910,
                300
            ],
            "parameters": {
                "jsCode": "// Calculate composite engagement scores\n// engagement_score = (upvotes * 1) + (replies * 3) + (DMs * 10) + (saves * 5)\nconst data = $input.first().json;\nconst now = new Date().toISOString();\n\nreturn [{ json: {\n  scan_completed: now,\n  formula: \"upvotes*1 + replies*3 + DMs*10 + saves*5\",\n  next_action: \"classify_outcomes\",\n  classification_rules: {\n    winner: \"engagement_score > 75th percentile after 14 days\",\n    loser: \"engagement_score < 25th percentile after 14 days\",\n    mid: \"everything else\"\n  }\n}}];"
            },
            "id": "9e93ba5c-eb7f-47c3-a15e-c1c91aea7b2a"
        },
        {
            "name": "Post Summary",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.2,
            "position": [
                1130,
                300
            ],
            "parameters": {
                "method": "POST",
                "url": "https://slack.com/api/chat.postMessage",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "slackApi",
                "sendBody": true,
                "specifyBody": "keypair",
                "options": {},
                "bodyParameters": {
                    "parameters": [
                        {
                            "name": "channel",
                            "value": "C0AKXAYJ41W"
                        },
                        {
                            "name": "text",
                            "value": "=Daily Outreach Engagement Scan\nTime: {{ $json.scan_completed }}\nFormula: {{ $json.formula }}\nClassification: winner (>75th pct) / mid / loser (<25th pct)"
                        }
                    ]
                },
                "contentType": "json"
            },
            "credentials": {
                "slackApi": {
                    "id": "To6ERybK9OzH9rtu",
                    "name": "slack-bot-auth"
                }
            },
            "id": "2b4facea-c00f-419d-bee4-b1c609e96daf"
        },
        {
            "name": "Seal Evidence",
