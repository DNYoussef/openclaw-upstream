                "jsCode": "// Log qualified leads for debugging\nconst leads = $input.all();\nconsole.log('Narrowcast scan complete: ' + leads.length + ' qualified leads');\nfor (const l of leads) {\n  console.log('  [' + l.json.ai_score + '] ' + l.json.pain_bucket + ' | ' + l.json.lane + ' | r/' + l.json.post_subreddit + ' | ' + l.json.signal_summary);\n}\nreturn leads;\n"
