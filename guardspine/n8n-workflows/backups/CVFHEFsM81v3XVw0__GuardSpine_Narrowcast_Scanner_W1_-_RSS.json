        {
            "parameters": {
                "jsCode": "// GuardSpine narrowcast: build Reddit RSS search URLs\n// No API key needed - uses public RSS feeds\nconst searches = [\n  { subreddit: 'devsecops', keywords: 'AI code review OR AI governance OR code audit' },\n  { subreddit: 'netsec', keywords: 'AI generated code OR code review automation OR audit trail' },\n  { subreddit: 'devops', keywords: 'AI code review OR PR review overload OR code governance' },\n  { subreddit: 'appsec', keywords: 'AI code review OR code governance OR approval workflow' },\n  { subreddit: 'cybersecurity', keywords: 'AI generated code risk OR code change governance' },\n  { subreddit: 'ExperiencedDevs', keywords: 'AI code review OR PR review fatigue OR code review bottleneck' },\n  { subreddit: 'startups', keywords: 'SOC 2 engineering OR enterprise security review' },\n  { subreddit: 'ciso', keywords: 'AI code risk OR developer governance OR code change audit' }\n];\n\nreturn searches.map(s => ({\n  json: {\n    subreddit: s.subreddit,\n    keywords: s.keywords,\n    rss_url: `https://www.reddit.com/r/${s.subreddit}/search.rss?q=${encodeURIComponent(s.keywords)}&sort=new&restrict_sr=on&limit=10`\n  }\n}));\n"
            },
            "id": "8625c68c-54ea-445c-8c4f-9bf078747985",
            "name": "Build RSS Feed URLs",
            "type": "n8n-nodes-base.code",
            "position": [
                1040,
                1568
            ],
            "typeVersion": 2
        },
        {
            "parameters": {
                "options": {}
            },
            "id": "003fd36c-b0d3-474f-ad2f-c363e9af2dbc",
            "name": "Loop Over Feeds",
            "type": "n8n-nodes-base.splitInBatches",
            "position": [
                1328,
                1568
            ],
            "typeVersion": 3
        },
        {
            "parameters": {
                "url": "={{ $json.rss_url }}",
                "options": {
                    "response": {
                        "response": {
                            "responseFormat": "text"
                        }
                    }
                }
            },
            "id": "c3626160-5e43-4429-a7c8-553fc833731d",
            "name": "Fetch Reddit RSS",
            "type": "n8n-nodes-base.httpRequest",
            "position": [
                1536,
                1712
            ],
            "typeVersion": 4.2
        },
        {
            "parameters": {
                "options": {}
            },
            "id": "6da651fb-8f5d-48db-b52e-207b841b443d",
            "name": "Parse RSS XML",
            "type": "n8n-nodes-base.xml",
            "position": [
                1728,
                1712
            ],
            "typeVersion": 1
        },
        {
            "parameters": {
                "jsCode": "// Extract posts from parsed RSS XML\nconst subreddit = $('Loop Over Feeds').item.json.subreddit;\nconst feed = $input.first().json;\n\n// Navigate RSS structure: feed > channel > item[]\nlet items = [];\ntry {\n  const channel = feed.feed?.entry || feed.rss?.channel?.item || feed?.channel?.item || [];\n  items = Array.isArray(channel) ? channel : (channel ? [channel] : []);\n} catch(e) {\n  return [{ json: { error: e.message, subreddit } }];\n}\n\nif (items.length === 0) return [];\n\nreturn items.map(item => ({\n  json: {\n    post_id: item.id || item.guid || item.link,\n    post_title: item.title || '',\n    postcontent: item.content || item.description || item['content:encoded'] || item.summary || '',\n    post_url: (typeof item.link === 'object' ? item.link?.['$']?.href : item.link) || '',\n    post_subreddit: subreddit,\n    post_author: item.author?.name || item['dc:creator'] || item.author || 'unknown',\n    post_published: item.published || item.pubDate || item.updated || new Date().toISOString(),\n    duplicate: false\n  }\n})).filter(p => p.json.post_title && p.json.post_title !== '');\n"
            },
            "id": "901ed0f2-dadd-430c-ba43-c39a3a5ddf91",
            "name": "Extract Posts from RSS",
            "type": "n8n-nodes-base.code",
            "position": [
                1936,
                1712
            ],
            "typeVersion": 2,
            "alwaysOutputData": true
        },
        {
            "parameters": {
                "jsCode": "// This node collects posts from loop iterations\nreturn $input.all();\n"
            },
            "id": "de082366-4733-46cd-b076-0b0ecdf2cbe6",
            "name": "Collect All Posts",
            "type": "n8n-nodes-base.code",
            "position": [
