            "webhookId": "ff50ebdc-1f18-4a00-8989-fb605c6ee84f"
        },
        {
            "parameters": {
                "promptType": "define",
                "text": "=You are a lead scorer for GuardSpine, a governance control plane for AI-speed code changes.\n\nAnalyze this Reddit post for GuardSpine sales relevance.\n\nSubreddit: r/{{ $('Loop Over Posts').item.json.post_subreddit }}\nTitle: {{ $('Loop Over Posts').item.json.post_title }}\nContent: {{ $('Loop Over Posts').item.json.postcontent.substring(0, 1500) }}\nAuthor: {{ $('Loop Over Posts').item.json.post_author }}\n\nScore 0-100 based on:\n- Does the author describe a PAIN that GuardSpine solves? (review overload, weak approval trail, evidence scramble, AI code governance gap, regulatory pressure)\n- Is this person likely a buyer? (AppSec lead, CTO, CISO, GRC, platform engineer, startup founder)\n- Is there a specific struggling moment? (not just general discussion)\n\nPAIN BUCKETS: review_velocity_gap | evidence_chain_gap | semantic_governance_gap | authorization_provenance_gap | regulatory_readiness_gap | not_relevant\n\nLANES: appsec_champion | cto_economic_buyer | ciso_blocker_or_accelerant | grc_accelerant | platform_technical_win | startup_founder | not_a_buyer\n\nRespond ONLY in this JSON format, nothing else:\n{\"score\": 0, \"pain_bucket\": \"not_relevant\", \"lane\": \"not_a_buyer\", \"confidence\": \"LOW\", \"signal_summary\": \"one sentence\", \"company_hint\": null, \"role_hint\": null}",
                "options": {}
            },
            "id": "16144237-579e-47e1-964b-9107d678fafd",
            "name": "AI Pain Signal Scorer",
            "type": "@n8n/n8n-nodes-langchain.agent",
            "position": [
                2688,
                1712
            ],
            "typeVersion": 1.7
        },
        {
            "parameters": {
                "model": {
                    "__rl": true,
                    "mode": "id",
                    "value": "anthropic/claude-sonnet-4-5"
                },
                "options": {
                    "maxTokens": 400
                }
            },
            "id": "245e8988-5db4-4050-a923-4549bd293e3e",
            "name": "OpenRouter (Claude Sonnet)",
            "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
            "position": [
                2880,
                1968
            ],
            "typeVersion": 1.2,
            "credentials": {
                "openAiApi": {
                    "id": "rHcW2FeM3AFjq3H3",
                    "name": "OpenAi account"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "const original = $('Loop Over Posts').item.json;\nconst aiOutput = $input.first().json.output || '';\nlet parsed;\ntry {\n  const match = aiOutput.match(/\\{[\\s\\S]*?\\}/);\n  parsed = match ? JSON.parse(match[0]) : { score: 0, pain_bucket: 'not_relevant', lane: 'not_a_buyer', confidence: 'LOW', signal_summary: 'Parse error' };\n} catch(e) {\n  parsed = { score: 0, pain_bucket: 'not_relevant', lane: 'not_a_buyer', confidence: 'LOW', signal_summary: 'JSON parse error: ' + e.message };\n}\nreturn [{\n  json: {\n    ...original,\n    ai_score: parsed.score || 0,\n    pain_bucket: parsed.pain_bucket || 'not_relevant',\n    lane: parsed.lane || 'not_a_buyer',\n    research_confidence: parsed.confidence || 'LOW',\n    signal_summary: parsed.signal_summary || '',\n    company_hint: parsed.company_hint || null,\n    role_hint: parsed.role_hint || null\n  }\n}];\n"
            },
            "id": "7bb3da50-1271-4be5-84dc-73c141c47d5d",
            "name": "Parse AI Score",
            "type": "n8n-nodes-base.code",
            "position": [
                2688,
                1920
            ],
            "typeVersion": 2,
            "alwaysOutputData": true
        },
        {
            "parameters": {
                "conditions": {
                    "options": {
                        "version": 2,
                        "caseSensitive": true,
                        "typeValidation": "strict"
                    },
                    "combinator": "and",
                    "conditions": [
                        {
                            "id": "score-threshold",
                            "operator": {
                                "type": "number",
                                "operation": "gte"
                            },
                            "leftValue": "={{ $json.ai_score }}",
                            "rightValue": 70
                        }
                    ]
                },
                "options": {}
            },
            "id": "5cc33297-8548-4b68-af8a-9cc0eb2e281c",
            "name": "Score >= 70?",
            "type": "n8n-nodes-base.if",
            "position": [
                2992,
                1568
            ],
            "typeVersion": 2.2
        },
        {
            "parameters": {
                "jsCode": "const leads = $input.all();\nif (leads.length === 0) {\n  return { json: { email: '<p>No qualified leads found in this scan.</p>', lead_count: 0 } };\n}\n\nlet html = '<h2>GuardSpine Narrowcast Scan Results</h2>';\nhtml += '<p>Scan completed: ' + new Date().toLocaleString('en-US', {timeZone: 'America/New_York'}) + ' ET</p>';\nhtml += '<p><b>' + leads.length + ' qualified leads</b> (score >= 70)</p>';\nhtml += '<table border=\"1\" cellpadding=\"8\" style=\"border-collapse:collapse; font-family:sans-serif;\">';\nhtml += '<tr style=\"background:#f0f0f0;\"><th>Score</th><th>Pain Bucket</th><th>Lane</th><th>Confidence</th><th>Signal</th><th>Subreddit</th><th>Link</th></tr>';\n\nfor (const item of leads) {\n  const d = item.json;\n  const bg = d.ai_score >= 85 ? '#ffe0e0' : (d.ai_score >= 75 ? '#fff3e0' : '#f0f8e0');\n  html += '<tr style=\"background:' + bg + ';\">';\n  html += '<td><b>' + d.ai_score + '</b></td>';\n  html += '<td>' + d.pain_bucket + '</td>';\n  html += '<td>' + d.lane + '</td>';\n  html += '<td>' + d.research_confidence + '</td>';\n  html += '<td>' + (d.signal_summary || '') + '</td>';\n  html += '<td>r/' + d.post_subreddit + '</td>';\n  html += '<td><a href=\"' + d.post_url + '\">View</a></td>';\n  html += '</tr>';\n}\nhtml += '</table>';\nhtml += '<p><i>Review these leads and assign to CMO agent for research note generation.</i></p>';\n\nreturn { json: { email: html, lead_count: leads.length } };\n"
            },
